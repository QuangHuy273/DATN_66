@inject NavigationManager Navigation
<link href="css/PhoneAuth.css" rel="stylesheet" />

<div class="otp-container">
    <h3>Xác minh số điện thoại</h3>

    <div class="phone-info">
        <p>📱 OTP mặc định: <strong>123456</strong></p>
    </div>

    <div class="otp-input-container">
        <input value="@otpCode"
               @oninput="OnOtpInput"
               class="otp-input @(GetInputClass())"
               placeholder="Nhập mã OTP"
               maxlength="6"
               type="tel" />
    </div>

    <button @onclick="VerifyOtp"
            class="verify-button"
            disabled="@(isLoading || string.IsNullOrWhiteSpace(otpCode))">
        Xác minh OTP
    </button>

    <div class="status-message @GetStatusClass()">
        <p>@status</p>
    </div>
</div>
@code {
    [Parameter] public string PhoneNumber { get; set; } = "";
    [Parameter] public EventCallback<string> OnTabChanged { get; set; }

    private string otpCode = "";
    private string status = "";
    private bool isLoading = false;
    private bool isValidOtp = false;
    private bool isInvalidOtp = false;

    private const string FIXED_OTP = "123456";

    private void OnOtpInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        otpCode = new string(value.Where(char.IsDigit).ToArray());

        if (otpCode.Length > 6)
            otpCode = otpCode.Substring(0, 6);
    }

    private async Task VerifyOtp()
    {
        if (otpCode.Length != 6)
        {
            status = "Vui lòng nhập đủ 6 số";
            isInvalidOtp = true;
            return;
        }

        if (otpCode != FIXED_OTP)
        {
            status = "OTP không đúng";
            isInvalidOtp = true;
            isValidOtp = false;
            return;
        }

        // ✅ OTP đúng
        status = "Xác minh thành công";
        isValidOtp = true;
        isInvalidOtp = false;

        if (OnTabChanged.HasDelegate)
        {
            await OnTabChanged.InvokeAsync("registerthongtin");
        }
    }

    private string GetInputClass()
    {
        if (isValidOtp) return "valid";
        if (isInvalidOtp) return "invalid";
        return "";
    }

    private string GetStatusClass()
    {
        if (isValidOtp) return "status-success";
        if (isInvalidOtp) return "status-error";
        return "";
    }
}

@inject IJSRuntime JS
@inject NavigationManager Nav
@* <link href="css/SanPham.css" rel="stylesheet" /> *@
<div class="product-card">
    <!-- Ảnh sản phẩm -->
    <div class="product-img" @onclick='() => Info(monAn)'>
        @if (!string.IsNullOrWhiteSpace(monAn.AnhDaTai))
        {
            <img src="@monAn.AnhDaTai" alt="@monAn.Ten" />
        }
        else
        {
            <div class="product-emoji">@GetProductEmoji(monAn.TheLoai)</div>
        }
        
    </div>

    <!-- Thông tin sản phẩm -->
    <div class="infor-card" @onclick='() => Info(monAn)'>
        <h3 class="product-name" title="@monAn.Ten">@monAn.Ten</h3>
        @if (!string.IsNullOrEmpty(monAn.ThuongHieu))
        {
            <p class="product-brand">@monAn.ThuongHieu</p>
        }
        @if (!string.IsNullOrEmpty(monAn.TheLoai))
        {
            <div class="product-brand">@monAn.TheLoai</div>
        }
        <div class="price-section">
            <span class="price">@FormatMoney(monAn.Gia)</span>
            <span class="stock-badge">
                <i class="bi bi-check-circle-fill"></i> Còn hàng
            </span>
        </div>
    </div>

    <!-- Nút thêm giỏ hàng -->
    <button class="add-to-cart" @onclick="() => AddToCart(monAn)">
        <i class="bi bi-cart-plus-fill"></i> Thêm vào giỏ
    </button>
</div>

<ThemVaoGio @ref="popup" Product="monAn" />
@code {
    [Parameter] public MonAnDTO monAn { get; set; }
    private ThemVaoGio popup;
    private string FormatMoney(decimal amount)
    {
        return string.Format("{0:N0} VND", amount);
    }
    private async void AddToCart(MonAnDTO item)
    {
        
        if (popup != null)
        {
            await popup.Show();
        }
    }
    private string GetProductEmoji(string? category)
    {
        return category switch
        {
            "Đồ ăn vặt" => "",
            "Thức uống" => "",
            "Đồ ngọt" => "",
            _ => ""
        };
    }
    private async Task Info(MonAnDTO product)
    {
        Nav.NavigateTo($"/ChiTietSanPham/{product.Id}");
    }
}
<style>
    /* ================== PRODUCT CARD FULL CSS NÂNG CAO ================== */
    :root {
        --primary-color: #ee4d2d;
        --primary-dark: #d73211;
        --primary-light: #ff7337;
        --text-dark: #1e293b;
        --text-muted: #64748b;
        --bg-light: #f7f7f7;
    }

    /* ===== Product Card ===== */
    .product-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 0;
        position: relative;
        transition: all 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

        .product-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-color), var(--primary-light));
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .product-card:hover::before {
            opacity: 1;
        }

    /* ===== Product Image ===== */
    .product-img {
        width: 100%;
        height: 240px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-light);
        overflow: hidden;
        position: relative;
        cursor: pointer;
        transition: all 0.35s ease;
    }

        .product-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transition: transform 0.4s ease, filter 0.4s ease;
        }

    .product-card:hover .product-img img {
        transform: scale(1.1) rotate(1deg);
        filter: brightness(1.05);
    }

    /* ===== Product Badge ===== */
    .product-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: linear-gradient(135deg,#ff6f4d,#ee4d2d);
        color: #fff;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        box-shadow: 0 2px 10px rgba(238,77,45,0.3);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .product-card:hover .product-badge {
        transform: scale(1.1) rotate(-5deg);
        box-shadow: 0 4px 20px rgba(238,77,45,0.4);
    }

    /* ===== Info Card ===== */
    .infor-card {
        padding: 12px 20px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex-grow: 1;
        min-height: 0;
        overflow: hidden;
    }

    /* ===== Product Name ===== */
    .product-name {
        font-size: 1.0625rem; /* Kích thước chữ chuẩn */
        font-weight: 600; /* Đậm vừa phải */
        color: #1e293b; /* Màu chữ chính */
        line-height: 1.3; /* Line-height gọn, không thừa khoảng trắng */
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2; /* Giới hạn 2 dòng */
        overflow: hidden;
        text-overflow: ellipsis; /* Dấu "..." nếu chữ dài */
        margin: 0; /* Bỏ khoảng trắng dư */
        transition: color 0.3s ease, transform 0.3s ease;
        cursor: pointer; /* Giống sàn TMĐT, người dùng biết click được */
    }

        .product-name:hover {
            color: #ee4d2d; /* Hover đổi màu nổi bật */
            transform: scale(1.02); /* Hover phóng to nhẹ */
        }

    /* ===== Product Brand ===== */
    .product-brand {
        font-size: 0.875rem;
        color: var(--text-muted);
        margin-top: 0;
        margin-bottom: 0;
    }

    /* ===== Price Section ===== */
    .price-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        border-top: 1px solid #f1f5f9;
        padding-top: 10px;
        margin-top: auto;
    }

    .price {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--primary-color);
    }

    /* ===== Stock Badge ===== */
    .stock-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        color: #16a34a;
        background: #f0fdf4;
        padding: 4px 10px;
        border-radius: 12px;
    }

    /* ===== Add to Cart Button ===== */
    .add-to-cart {
        margin: 12px 16px 16px;
        padding: 14px 20px;
        border-radius: 12px;
        background: linear-gradient(135deg,#ee4d2d,#ff7337);
        color: #fff;
        font-weight: 600;
        font-size: 0.9375rem;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 12px rgba(238,77,45,0.25);
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

        .add-to-cart::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg,transparent, rgba(255,255,255,0.25), transparent);
            transition: left 0.5s ease;
        }

        .add-to-cart:hover::before {
            left: 100%;
        }

        .add-to-cart:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 20px rgba(238,77,45,0.35);
        }

        /* Ripple effect khi click */
        .add-to-cart:active::after {
            content: "";
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background: rgba(255,255,255,0.2);
            opacity: 1;
            transition: 0s;
        }

    /* ===== Responsive ===== */
    @@media (max-width:768px) {
        .product-card

    {
        border-radius: 12px;
    }

    .product-img {
        height: 200px;
    }

    .infor-card {
        padding: 10px 16px;
        gap: 3px;
    }

    .product-name {
        font-size: 0.9375rem;
        height: 42px;
        line-height: 1.3;
    }

    .product-brand {
        font-size: 0.8125rem;
    }

    .price {
        font-size: 1.125rem;
    }

    .stock-badge {
        font-size: 0.6875rem;
        padding: 3px 8px;
    }

    .add-to-cart {
        padding: 12px 16px;
        font-size: 0.875rem;
        margin: 0 12px 12px;
        gap: 6px;
    }
</style>

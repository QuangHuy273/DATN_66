 @page "/quan-ly-san-pham/them-chi-tiet-mon-an/{MonAnId}"
@page "/quan-ly-san-pham/them-chi-tiet-mon-an/{MonAnId}/{Id}"
@page "/quanlysanpham/them-chi-tiet-mon-an/{MonAnId}"
@page "/quanlysanpham/them-chi-tiet-mon-an/{MonAnId}/{Id}"
@using Admin.Service.IService
@using API.Models.DTO
@using Microsoft.AspNetCore.Components.Forms
@inject IChiTietMonAnService ChiTietMonAnService
@inject IMonAnService MonAnService
@inject IApiService ApiService
@inject IUploadService UploadService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>@(string.IsNullOrEmpty(Id) ? "Thêm Chi Tiết Món Ăn" : "Sửa Chi Tiết Món Ăn")</PageTitle>

<link href="css/ThemMonAn.css" rel="stylesheet" />

<div class="them-chi-tiet-mon-an-container">
    <div class="header-section">
        <h2>
            <i class="bi bi-@(string.IsNullOrEmpty(Id) ? "plus-circle-fill" : "pencil-square")"></i>
            @(string.IsNullOrEmpty(Id) ? "Thêm Chi Tiết Món Ăn" : "Sửa Chi Tiết Món Ăn")
        </h2>
        <button class="btn btn-secondary" @onclick="QuayLai" type="button">
            <i class="bi bi-arrow-left"></i> Quay Lại
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading" style="display: flex; flex-direction: column; align-items: center; gap: 24px; padding: 80px 20px;">
            <div style="position: relative;">
                <span class="spinner-border" role="status" style="width: 4rem; height: 4rem; color: #667eea; border-width: 4px;"></span>
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 20px;">
                    <i class="bi bi-hourglass-split" style="color: #667eea; animation: pulse 1.5s ease-in-out infinite;"></i>
                </div>
            </div>
            <div style="text-align: center;">
                <p style="margin: 0; font-size: 18px; font-weight: 700; color: #2d3748; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    Đang tải dữ liệu...
                </p>
                <p style="margin: 8px 0 0; font-size: 14px; color: #718096;">Vui lòng chờ trong giây lát</p>
            </div>
        </div>
    }
    else
    {
        <EditForm Model="@chiTietMonAn" OnValidSubmit="@LuuChiTietMonAn">
            <DataAnnotationsValidator />
            <div class="form-container">
                <div style="background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%); padding: 24px; border-radius: 16px; border: 2px solid #e2e8f0; margin-bottom: 28px;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 2px solid #e2e8f0;">
                        <span style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-size: 18px;">
                            <i class="bi bi-info-circle-fill"></i>
                        </span>
                        <h5 style="margin: 0; font-weight: 700; color: #2d3748; font-size: 17px;">Thông Tin Món Ăn</h5>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="monAnId">
                                    <i class="bi bi-upc-scan"></i>
                                    Mã Món Ăn
                                </label>
                                <InputText id="monAnId" class="form-control" @bind-Value="chiTietMonAn.MonAnId" disabled style="background: #f1f3f5; cursor: not-allowed;" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ten">
                                    <i class="bi bi-card-heading"></i>
                                    Tên Món Ăn
                                </label>
                                <InputText id="ten" class="form-control" @bind-Value="chiTietMonAn.Ten" disabled style="background: #f1f3f5; cursor: not-allowed;" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="gia">
                                <i class="bi bi-cash-stack"></i>
                                Giá <span class="text-danger">*</span>
                            </label>
                            <InputNumber id="gia" class="form-control" @bind-Value="chiTietMonAn.Gia" />
                            <ValidationMessage For="@(() => chiTietMonAn.Gia)" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="soLuong">
                                <i class="bi bi-box-seam"></i>
                                Số Lượng <span class="text-danger">*</span>
                            </label>
                            <InputNumber id="soLuong" class="form-control" @bind-Value="chiTietMonAn.Soluong" />
                            <ValidationMessage For="@(() => chiTietMonAn.Soluong)" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="soNgayHSD">
                                <i class="bi bi-calendar-check"></i>
                                Số Ngày HSD <span class="text-danger">*</span>
                            </label>
                            <InputNumber id="soNgayHSD" class="form-control" @bind-Value="chiTietMonAn.SoNgayHSD" />
                            <ValidationMessage For="@(() => chiTietMonAn.SoNgayHSD)" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="trangThai">
                                <i class="bi bi-toggle-on"></i>
                                Trạng Thái
                            </label>
                            <InputSelect id="trangThai" class="form-select" @bind-Value="trangThaiString" @bind-Value:after="OnTrangThaiChanged">
                                <option value="true">✓ Hoạt động</option>
                                <option value="false">⊗ Tạm dừng</option>
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="nguyenLieu">
                                <i class="bi bi-egg-fried"></i>
                                Nguyên Liệu
                            </label>
                            <InputSelect id="nguyenLieu" class="form-select" @bind-Value="selectedNguyenLieuId">
                                <option value="">🥚 Chọn Nguyên Liệu</option>
                                @foreach (var nl in nguyenLieus)
                                {
                                    <option value="@nl.Id">@nl.Ten</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="nhaCungCap">
                                <i class="bi bi-truck-front-fill"></i>
                                Nhà Cung Cấp
                            </label>
                            <InputSelect id="nhaCungCap" class="form-select" @bind-Value="selectedNhaCungCapId">
                                <option value="">🚚 Chọn Nhà Cung Cấp</option>
                                @foreach (var ncc in nhaCungCaps)
                                {
                                    <option value="@ncc.Id">@ncc.Ten</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="loaiVi">
                                <i class="bi bi-cup-hot-fill"></i>
                                Loại Vị
                            </label>
                            <InputSelect id="loaiVi" class="form-select" @bind-Value="selectedLoaiViId">
                                <option value="">☕ Chọn Loại Vị</option>
                                @foreach (var lv in loaiVis)
                                {
                                    <option value="@lv.Id">@lv.Ten</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="kichCo">
                                <i class="bi bi-rulers"></i>
                                Kích Cỡ
                            </label>
                            <InputSelect id="kichCo" class="form-select" @bind-Value="selectedKichCoId">
                                <option value="">📏 Chọn Kích Cỡ</option>
                                @foreach (var kc in kichCos)
                                {
                                    <option value="@kc.Id">@kc.Ten</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="mota">
                        <i class="bi bi-file-text"></i>
                        Mô Tả
                    </label>
                    <InputTextArea id="mota" class="form-control" rows="4" @bind-Value="chiTietMonAn.Mota" placeholder="Nhập mô tả chi tiết về sản phẩm..." />
                </div>

                <div class="form-group">
                    <label>
                        <i class="bi bi-images-fill"></i>
                        Ảnh Chi Tiết Món Ăn
                    </label>
                    <InputFile class="form-control" OnChange="OnAnhChiTietSelected" accept="image/*" multiple />
                    <small class="form-text text-muted">Chọn nhiều ảnh (JPG, PNG, tối đa 5MB mỗi ảnh)</small>
                    @if (chiTietMonAn.DanhSachAnh != null && chiTietMonAn.DanhSachAnh.Any())
                    {
                        <div class="mt-4 d-flex flex-wrap gap-3" style="padding: 20px; background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%); border-radius: 16px; border: 2px dashed #cbd5e0;">
                            <div style="width: 100%; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 2px solid #e2e8f0;">
                                <span style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);">
                                    <i class="bi bi-collection-fill" style="margin-right: 6px;"></i>@chiTietMonAn.DanhSachAnh.Count ảnh
                                </span>
                            </div>
                            @for (int imgIndex = 0; imgIndex < chiTietMonAn.DanhSachAnh.Count; imgIndex++)
                            {
                                var anh = chiTietMonAn.DanhSachAnh[imgIndex];
                                var imageNumber = imgIndex + 1;
                                <div class="position-relative" style="width: 150px; height: 150px; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12); transition: all 0.3s ease; animation: fadeIn 0.3s ease;">
                                    <img src="@GetImageUrlWithCacheBusting(anh.DuongDan)" alt="@anh.Ten" class="img-thumbnail" style="width: 100%; height: 100%; object-fit: cover; border: none;" title="Click để xem ảnh lớn" />
                                    <div style="position: absolute; bottom: 8px; left: 8px; background: rgba(102, 126, 234, 0.95); color: white; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700; box-shadow: 0 2px 8px rgba(0,0,0,0.3);">
                                        #@imageNumber
                                    </div>
                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0" style="margin: 8px; border-radius: 10px; padding: 6px 10px; font-weight: 700; box-shadow: 0 4px 12px rgba(220, 53, 69, 0.4);" @onclick="async () => await XoaAnhChiTiet(anh.Id)" title="Xóa ảnh này">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    @if (isUploadingAnh)
                    {
                        <div class="mt-3 d-flex align-items-center gap-3" style="padding: 16px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 12px;">
                            <span class="spinner-border spinner-border-sm" role="status" style="color: #667eea;"></span>
                            <span style="color: #667eea; font-weight: 600; font-size: 14px;">Đang tải ảnh lên...</span>
                        </div>
                    }
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@isSaving" style="min-width: 160px;">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Lưu Thông Tin</span>
                        }
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="QuayLai" disabled="@isSaving" style="min-width: 120px;">
                        <i class="bi bi-x-circle-fill"></i>
                        Hủy Bỏ
                    </button>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    
    // Parameters
    
    [Parameter] public string MonAnId { get; set; } = string.Empty;
    [Parameter] public string? Id { get; set; }

    
    // State
    
    private ChiTietMonAnDTO chiTietMonAn = new ChiTietMonAnDTO
    {
        MonAnId = string.Empty,
        Ten = string.Empty,
        Gia = 0,
        Soluong = 0,
        SoNgayHSD = 0,
        TrangThai = false,
        DanhSachAnh = new List<AnhDTO>()
    };

    private List<DongGoiDTO> nguyenLieus = new();
    private List<NhaCungCapDTO> nhaCungCaps = new();
    private List<LoaiViDTO> loaiVis = new();
    private List<KichCoDTO> kichCos = new();

    private Guid? selectedNguyenLieuId;
    private Guid? selectedNhaCungCapId;
    private Guid? selectedLoaiViId;
    private Guid? selectedKichCoId;

    private bool isSaving = false;
    private bool isLoading = true;
    private bool isUploadingAnh = false;

    
    // Computed properties
    
    private string trangThaiString
    {
        get => chiTietMonAn.TrangThai.ToString().ToLower();
        set => chiTietMonAn.TrangThai = bool.Parse(value);
    }

    private void OnTrangThaiChanged()
    {
        StateHasChanged();
    }

    
    // Lifecycle
    
    protected override async Task OnInitializedAsync()
    {
        await LoadDropdownData();
        await LoadMonAnInfo();

        if (!string.IsNullOrEmpty(Id) && Guid.TryParse(Id, out var chiTietId))
        {
            await LoadChiTietMonAn(chiTietId);
        }

        isLoading = false;
    }

    
    // Data loading
    
    private async Task LoadDropdownData()
    {
        try
        {
            var tasks = new List<Task>
            {
                LoadNguyenLieu(),
                LoadNhaCungCap(),
                LoadLoaiVi(),
                LoadKichCo()
            };
            await Task.WhenAll(tasks);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dropdown data: {ex.Message}");
        }
    }

    private async Task LoadNguyenLieu()
    {
        try
        {
            nguyenLieus = await ChiTietMonAnService.GetAsync<List<DongGoiDTO>>("NguyenLieu") ?? new List<DongGoiDTO>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading NguyenLieu: {ex.Message}");
            nguyenLieus = new List<DongGoiDTO>();
        }
    }

    private async Task LoadNhaCungCap()
    {
        try
        {
            nhaCungCaps = await ChiTietMonAnService.GetAsync<List<NhaCungCapDTO>>("NhaCungCap") ?? new List<NhaCungCapDTO>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading NhaCungCap: {ex.Message}");
            nhaCungCaps = new List<NhaCungCapDTO>();
        }
    }

    private async Task LoadLoaiVi()
    {
        try
        {
            loaiVis = await ChiTietMonAnService.GetAsync<List<LoaiViDTO>>("LoaiVi") ?? new List<LoaiViDTO>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading LoaiVi: {ex.Message}");
            loaiVis = new List<LoaiViDTO>();
        }
    }

    private async Task LoadKichCo()
    {
        try
        {
            kichCos = await ChiTietMonAnService.GetAsync<List<KichCoDTO>>("KichCo") ?? new List<KichCoDTO>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading KichCo: {ex.Message}");
            kichCos = new List<KichCoDTO>();
        }
    }

    private async Task LoadMonAnInfo()
    {
        if (string.IsNullOrEmpty(MonAnId)) return;

        try
        {
            var monAn = await MonAnService.GetById(MonAnId);
            if (monAn != null)
            {
                chiTietMonAn.MonAnId = monAn.Id ?? string.Empty;
                chiTietMonAn.Ten = monAn.Ten;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading MonAn: {ex.Message}");
        }
    }

    private async Task LoadChiTietMonAn(Guid id)
    {
        try
        {
            var loaded = await ChiTietMonAnService.GetById(id);
            if (loaded != null)
            {
                chiTietMonAn = loaded;
                selectedNguyenLieuId = chiTietMonAn.NguyenLieuId;
                selectedNhaCungCapId = chiTietMonAn.NhaCungCapId;
                selectedLoaiViId = chiTietMonAn.LoaiViId;
                selectedKichCoId = chiTietMonAn.KichCoId;
                chiTietMonAn.DanhSachAnh ??= new List<AnhDTO>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading ChiTietMonAn: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Không thể tải thông tin chi tiết món ăn!");
        }
    }

    
    // Save logic
    
    private async Task LuuChiTietMonAn()
    {
        isSaving = true;
        try
        {
            chiTietMonAn.MonAnId = MonAnId;
            chiTietMonAn.NguyenLieuId = selectedNguyenLieuId;
            chiTietMonAn.NhaCungCapId = selectedNhaCungCapId;
            chiTietMonAn.LoaiViId = selectedLoaiViId;
            chiTietMonAn.KichCoId = selectedKichCoId;

            bool isNewChiTiet = string.IsNullOrEmpty(Id) || chiTietMonAn.Id == Guid.Empty;
            bool result = false;

            if (isNewChiTiet)
            {
                Console.WriteLine("[DEBUG] Đang tạo chi tiết món ăn mới...");
                var createdChiTiet = await ChiTietMonAnService.Create(chiTietMonAn);
                result = createdChiTiet != null && createdChiTiet.Id != Guid.Empty;
                
                if (result)
                {
                    chiTietMonAn.Id = createdChiTiet.Id;
                    Console.WriteLine($"[SUCCESS] Đã tạo chi tiết món ăn với Id: {chiTietMonAn.Id}");
                }
                else
                {
                    Console.WriteLine("[ERROR] Không thể tạo chi tiết món ăn");
                }
            }
            else
            {
                Console.WriteLine($"[DEBUG] Đang cập nhật chi tiết món ăn (Id: {chiTietMonAn.Id})...");
                
                // Tạo DTO clean để update
                var updateDto = new ChiTietMonAnDTO
                {
                    Id = chiTietMonAn.Id,
                    MonAnId = chiTietMonAn.MonAnId,
                    Ten = chiTietMonAn.Ten,
                    Gia = chiTietMonAn.Gia,
                    Soluong = chiTietMonAn.Soluong,
                    SoNgayHSD = chiTietMonAn.SoNgayHSD,
                    TrangThai = chiTietMonAn.TrangThai,
                    Mota = chiTietMonAn.Mota,
                    LoaiViId = chiTietMonAn.LoaiViId,
                    KichCoId = chiTietMonAn.KichCoId,
                    NguyenLieuId = chiTietMonAn.NguyenLieuId,
                    NhaCungCapId = chiTietMonAn.NhaCungCapId,
                    DanhSachAnh = null
                };
                
                result = await ChiTietMonAnService.Update(updateDto);
                
                if (result)
                {
                    Console.WriteLine("[SUCCESS] Đã cập nhật chi tiết món ăn");
                }
                else
                {
                    Console.WriteLine("[ERROR] Không thể cập nhật chi tiết món ăn");
                }
            }

            if (result)
            {
                await LuuAnhChiTiet();
                await JS.InvokeVoidAsync("alert", isNewChiTiet ? "Thêm chi tiết món ăn thành công!" : "Cập nhật chi tiết món ăn thành công!");
                Navigation.NavigateTo("/quanlysanpham");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Lưu chi tiết món ăn thất bại! Vui lòng kiểm tra dữ liệu và thử lại.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Exception khi lưu chi tiết món ăn: {ex.Message}");
            Console.WriteLine($"[ERROR] Stack trace: {ex.StackTrace}");
            await JS.InvokeVoidAsync("alert", $"Đã xảy ra lỗi khi lưu chi tiết món ăn: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    
    // Image upload & delete
    
    private async Task OnAnhChiTietSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles();
        if (files == null || files.Count == 0)
        {
            return;
        }

        isUploadingAnh = true;
        try
        {
            var anhList = EnsureDanhSachAnh();
            var chiTietDescriptor = BuildChiTietAnhDescriptor();
            var maMonAnDescriptor = BuildMaMonAnDescriptor();
            var startIndex = anhList.Count;
            var offset = 0;

            foreach (var file in files)
            {
                if (file.Size > 5 * 1024 * 1024)
                {
                    await JS.InvokeVoidAsync("alert", $"Ảnh {file.Name} vượt quá dung lượng tối đa 5MB!");
                    continue;
                }

                // Upload ảnh chi tiết với định dạng {MaMonAn}_{CT + số thứ tự chi tiết}_{index}_{timestamp}.ext
                var uploadResult = await UploadService.UploadImageAsync(
                    file,
                    maMonAnDescriptor,
                    chiTietDescriptor,
                    startIndex + offset);
                if (uploadResult == null)
                {
                    await JS.InvokeVoidAsync("alert", $"Không thể tải ảnh {file.Name}, vui lòng thử lại!");
                    continue;
                }

                anhList.Add(new AnhDTO
                {
                    Id = Guid.NewGuid(),
                    Ten = uploadResult.FileName,
                    DuongDan = uploadResult.Url
                });

                offset++;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading detail images: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Đã xảy ra lỗi khi tải ảnh!");
        }
        finally
        {
            isUploadingAnh = false;
            StateHasChanged();
        }
    }

    private async Task XoaAnhChiTiet(Guid anhId)
    {
        if (chiTietMonAn.DanhSachAnh == null || !chiTietMonAn.DanhSachAnh.Any())
        {
            return;
        }

        var anh = chiTietMonAn.DanhSachAnh.FirstOrDefault(a => a.Id == anhId);
        if (anh == null)
        {
            return;
        }

        var fileName = GetFileNameFromAnh(anh);
        if (!string.IsNullOrWhiteSpace(fileName))
        {
            await DeletePhysicalImageAsync(fileName);
        }

        if (anh.ChiTietMonAnId != null && anh.ChiTietMonAnId != Guid.Empty)
        {
            try
            {
                await ApiService.DeleteAsync<Guid>("Anh", anh.Id);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting image record: {ex.Message}");
            }
        }

        chiTietMonAn.DanhSachAnh.Remove(anh);
        StateHasChanged();
    }

    private List<AnhDTO> EnsureDanhSachAnh()
    {
        chiTietMonAn.DanhSachAnh ??= new List<AnhDTO>();
        return chiTietMonAn.DanhSachAnh;
    }

    private async Task LuuAnhChiTiet()
    {
        if (chiTietMonAn.DanhSachAnh == null || !chiTietMonAn.DanhSachAnh.Any())
        {
            return;
        }

        var anhMoi = chiTietMonAn.DanhSachAnh
            .Where(a => a.ChiTietMonAnId == null || a.ChiTietMonAnId == Guid.Empty)
            .ToList();

        if (!anhMoi.Any())
        {
            return;
        }

        foreach (var anh in anhMoi)
        {
            anh.ChiTietMonAnId = chiTietMonAn.Id;
        }

        var savedAnhs = await ApiService.PostAsync<List<AnhDTO>, List<AnhDTO>>("Anh/upload-many", anhMoi);
        if (savedAnhs == null || !savedAnhs.Any())
        {
            await JS.InvokeVoidAsync("alert", "Không thể lưu ảnh chi tiết, vui lòng thử lại!");
            return;
        }

        foreach (var savedAnh in savedAnhs)
        {
            var localAnh = chiTietMonAn.DanhSachAnh.FirstOrDefault(a => a.DuongDan == savedAnh.DuongDan);
            if (localAnh != null)
            {
                localAnh.Id = savedAnh.Id;
                localAnh.ChiTietMonAnId = savedAnh.ChiTietMonAnId;
            }
        }
    }

    
    // Helpers
    
    private string? GetFileNameFromAnh(AnhDTO? anh)
    {
        if (anh == null)
        {
            return null;
        }

        if (!string.IsNullOrWhiteSpace(anh.Ten))
        {
            return anh.Ten;
        }

        return ExtractFileName(anh.DuongDan);
    }

    private static string? ExtractFileName(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return null;
        }

        if (Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            return System.IO.Path.GetFileName(uri.LocalPath);
        }

        return System.IO.Path.GetFileName(url);
    }

    private async Task DeletePhysicalImageAsync(string? fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName))
        {
            return;
        }

        try
        {
            await UploadService.DeleteImageAsync(fileName);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting file {fileName}: {ex.Message}");
        }
    }

    private string? BuildMaMonAnDescriptor()
    {
        if (!string.IsNullOrWhiteSpace(chiTietMonAn.MonAnId))
        {
            return chiTietMonAn.MonAnId.Trim();
        }

        if (!string.IsNullOrWhiteSpace(chiTietMonAn.Ten))
        {
            return chiTietMonAn.Ten.Trim();
        }

        return null;
    }


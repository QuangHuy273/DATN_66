@page "/quan-ly-san-pham"
@page "/quanlysanpham"
@using Admin.Service.IService
@using API.Models.DTO
@inject IMonAnService MonAnService
@inject IChiTietMonAnService ChiTietMonAnService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Quản Lý Sản Phẩm</PageTitle>

<link href="css/QuanLySanPham.css" rel="stylesheet" />

<div class="quan-ly-san-pham-container">
    <div class="header-section">
        <h2><i class="bi bi-box-seam"></i> Quản Lý Sản Phẩm</h2>
        <button class="btn btn-primary" @onclick="ThemMonAnMoi">
            <i class="bi bi-plus-circle"></i> Thêm Món Ăn Mới
        </button>
    </div>

    <div class="search-section">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text"
                   placeholder="Tìm kiếm sản phẩm..."
                   @bind="searchKeyword"
                   @oninput="OnSearchInput"
                   class="search-input" />
        </div>
    </div>

    <div class="stats-section">
        <div class="stat-card">
            <div class="stat-icon total">
                <i class="bi bi-box-seam"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Tổng Sản Phẩm</div>
                <div class="stat-value">@totalProducts</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon active">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Đang Hoạt Động</div>
                <div class="stat-value">@activeProducts</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon inactive">
                <i class="bi bi-x-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Tạm Dừng</div>
                <div class="stat-value">@inactiveProducts</div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading">
            <p>Đang tải dữ liệu...</p>
        </div>
    }
    else if (filteredMonAns == null || !filteredMonAns.Any())
    {
        <div class="empty-state">
            <p>@(string.IsNullOrWhiteSpace(searchKeyword) ? "Chưa có món ăn nào. Hãy thêm món ăn mới!" : "Không tìm thấy sản phẩm nào phù hợp.")</p>
        </div>
    }
    else
    {
        <div class="product-grid row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-4">
            @foreach (var monAn in filteredMonAns)
            {
                <div class="col">
                    <div class="card product-card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(monAn.AnhDaTai))
                        {
                            <img src="@GetImageUrlWithCacheBusting(monAn.AnhDaTai)"
                                 alt="Ảnh @monAn.Ten"
                                 class="card-img-top product-cover" />
                        }
                        else
                        {
                            <div class="product-cover placeholder d-flex flex-column justify-content-center align-items-center text-muted">
                                <i class="bi bi-image fs-1 mb-2"></i>
                                <span>Chưa có ảnh</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column gap-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="text-muted small d-block mb-1" style="font-weight: 600; letter-spacing: 0.5px;">#@monAn.Id</span>
                                    <h5 class="card-title mb-0 text-truncate" style="max-width: 180px;" title="@monAn.Ten">@monAn.Ten</h5>
                                </div>
                                <span class="badge status-badge @(monAn.TrangThai ? "bg-success" : "bg-secondary")">
                                    @(monAn.TrangThai ? "Hoạt động" : "Tạm dừng")
                                </span>
                            </div>

                            <div class="d-flex flex-column gap-2 text-muted small">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-semibold text-dark">Danh mục</span>
                                    <span>@(monAn.TheLoai ?? "Chưa có danh mục")</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="fw-semibold text-dark">Số lượng chi tiết</span>
                                    <span>@GetVariantCount(monAn.Id) biến thể</span>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                <button class="btn btn-sm btn-info flex-fill" @onclick="() => OpenViewDetailModal(monAn)">
                                    <i class="bi bi-eye"></i> Xem Chi Tiết
                                </button>
                                <button class="btn btn-sm btn-warning flex-fill" @onclick="() => SuaMonAn(monAn.Id)">
                                    <i class="bi bi-pencil"></i> Chỉnh Sửa
                                </button>
                                <button class="btn btn-sm btn-danger flex-fill" @onclick="() => XoaMonAn(monAn.Id)">
                                    <i class="bi bi-trash"></i> Xóa
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- MODAL XEM CHI TIẾT (MỚI - MỞ RỘNG) -->
@if (isViewDetailModalOpen && selectedMonAn != null)
{
    <!-- Backdrop -->
    <div class="modal-backdrop show" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1040;"></div>

    <div class="modal show d-block" tabindex="-1" style="z-index: 1050; overflow-y: auto;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: #4f46e5; color: white;">
                    <h5 class="modal-title"><i class="bi bi-eye me-2"></i>Chi Tiết Món Ăn</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseViewDetailModal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="max-height: 80vh; overflow-y: auto;">
                    <!-- ===== PHẦN 1: THÔNG TIN CHUNG MÓN ĂN ===== -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                            <h6 class="mb-0 fw-bold" style="color: #1e293b;"><i class="bi bi-info-circle me-2" style="color: #4f46e5;"></i>Thông Tin Món Ăn</h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <!-- Cột ảnh món ăn chính -->
                                <div class="col-md-4 text-center mb-3 mb-md-0">
                                    @if (!string.IsNullOrWhiteSpace(selectedMonAn.AnhDaTai))
                                    {
                                        <img src="@GetImageUrlWithCacheBusting(selectedMonAn.AnhDaTai)" 
                                             class="img-fluid rounded shadow-sm" 
                                             alt="Ảnh món ăn" 
                                             style="max-height: 250px; object-fit: cover; width: 100%;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="height: 250px;">
                                            <div class="text-center">
                                                <i class="bi bi-image fs-1 text-muted"></i>
                                                <p class="text-muted mt-2 mb-0">Không có ảnh</p>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Cột thông tin chi tiết -->
                                <div class="col-md-8">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-tag me-1"></i>Tên món ăn</label>
                                            <input type="text" class="form-control" disabled value="@selectedMonAn.Ten" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-collection me-1"></i>Danh mục</label>
                                            <input type="text" class="form-control" disabled value="@(selectedMonAn.TheLoai ?? "N/A")" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-award me-1"></i>Thương hiệu</label>
                                            <input type="text" class="form-control" disabled value="@(selectedMonAn.ThuongHieu ?? "N/A")" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-toggle-on me-1"></i>Trạng thái</label>
                                            <input type="text" class="form-control" disabled 
                                                   value="@(selectedMonAn.TrangThai ? "Đang hoạt động" : "Tạm dừng")"
                                                   style="@(selectedMonAn.TrangThai ? "color: #28a745; font-weight: 600;" : "color: #6c757d; font-weight: 600;")" />
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-file-text me-1"></i>Mô tả</label>
                                        <textarea class="form-control" disabled rows="4" style="resize: none;">@(selectedMonAn.Mota ?? "Chưa có mô tả")</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ===== PHẦN 2: DANH SÁCH BIẾN THỂ ===== -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                            <h6 class="mb-0 fw-bold" style="color: #1e293b;"><i class="bi bi-list-ul me-2" style="color: #4f46e5;"></i>Danh Sách Biến Thể Chi Tiết</h6>
                        </div>
                        <div class="card-body">
                            @if (selectedMonAnDetails != null && selectedMonAnDetails.Any())
                            {
                                var detailIndex = 0;
                                @foreach (var ct in selectedMonAnDetails)
                                {
                                    detailIndex++;
                                    <div class="card mb-3 border shadow-sm">
                                        <div class="card-header" style="background: #4f46e5; color: white;">
                                            <h6 class="mb-0 fw-bold">
                                                <i class="bi bi-box-seam me-2"></i>Biến Thể: @ct.Ten
                                                <span class="badge @(ct.TrangThai ? "bg-success" : "bg-secondary") float-end">
                                                    @(ct.TrangThai ? "Hoạt Động" : "Tạm Dừng")
                                                </span>
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <!-- Hiển thị danh sách ảnh của biến thể (nếu có) -->
                                            @if (ct.DanhSachAnh != null && ct.DanhSachAnh.Any())
                                            {
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold mb-2" style="color: #475569;"><i class="bi bi-images me-1" style="color: #4f46e5;"></i>Danh Sách Ảnh Biến Thể</label>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        @foreach (var anh in ct.DanhSachAnh)
                                                        {
                                                            @if (!string.IsNullOrWhiteSpace(anh.DuongDan))
                                                            {
                                                                <div class="border rounded" style="width: 120px; height: 120px; border: 2px solid #e2e8f0 !important; overflow: hidden;">
                                                                    <img src="@GetImageUrlWithCacheBusting(anh.DuongDan)" 
                                                                         alt="Ảnh biến thể" 
                                                                         class="img-fluid" 
                                                                         style="width: 100%; height: 100%; object-fit: cover;" />
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            <div class="row">
                                                <div class="col-md-3 mb-3">
                                                    <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-cup-straw me-1"></i>Loại vị</label>
                                                    <input type="text" class="form-control" disabled value="@(ct.LoaiVi ?? "N/A")" />
                                                </div>
                                                <div class="col-md-3 mb-3">
                                                    <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-rulers me-1"></i>Kích cỡ</label>
                                                    <input type="text" class="form-control" disabled value="@(ct.KichCo ?? "N/A")" />
                                                </div>
                                                <div class="col-md-3 mb-3">
                                                    <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-building me-1"></i>Nhà cung cấp</label>
                                                    <input type="text" class="form-control" disabled value="@(ct.NhaCungCap ?? "N/A")" />
                                                </div>
                                                <div class="col-md-3 mb-3">
                                                    <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-egg-fried me-1"></i>Nguyên liệu</label>
                                                    <input type="text" class="form-control" disabled value="@(ct.NguyenLieu ?? "N/A")" />
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-3 mb-3">
                                                    <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-currency-dollar me-1"></i>Giá bán</label>
                                                    <input type="text" class="form-control fw-bold text-primary" disabled 
                                                           value="@ct.Gia.ToString("N0") đ" />
                                                </div>
                                                <div class="col-md-3 mb-3">
                                                    <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-box me-1"></i>Số lượng tồn</label>
                                                    <input type="text" class="form-control fw-bold" disabled 
                                                           value="@ct.Soluong"
                                                           style="@(ct.Soluong > 0 ? "color: #28a745;" : "color: #dc3545;")" />
                                                </div>
                                                <div class="col-md-3 mb-3">
                                                    <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-calendar-check me-1"></i>Số ngày HSD</label>
                                                    <input type="text" class="form-control" disabled value="@ct.SoNgayHSD ngày" />
                                                </div>
                                                <div class="col-md-3 mb-3">
                                                    <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-percent me-1"></i>Giá giảm</label>
                                                    <input type="text" class="form-control text-danger fw-bold" disabled 
                                                           value="@(ct.GiaGiam > 0 ? ct.GiaGiam.ToString("N0") + " đ" : "Không có")" />
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(ct.Mota))
                                            {
                                                <div class="mb-0">
                                                    <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-chat-left-text me-1"></i>Mô tả biến thể</label>
                                                    <textarea class="form-control" disabled rows="2" style="resize: none;">@ct.Mota</textarea>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-4 rounded" style="background: #f8fafc; color: #64748b;">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    <p class="mb-0">Món ăn này chưa có chi tiết biến thể nào.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0;">
                    <button type="button" class="btn btn-secondary px-4" @onclick="CloseViewDetailModal">
                        <i class="bi bi-x-lg"></i> Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ============================
    // State
    // ============================
    private List<MonAnDTO>? monAns;
    private List<MonAnDTO>? filteredMonAns;
    private List<ChiTietMonAnDTO>? chiTietMonAns;
    private bool isLoading = true;
    private string searchKeyword = string.Empty;

    // State cho Modal Xem Chi Tiết (MỚI)
    private bool isViewDetailModalOpen = false;
    private MonAnDTO? selectedMonAn;
    private List<ChiTietMonAnDTO>? selectedMonAnDetails;


    // Computed properties
    private int totalProducts => monAns?.Count ?? 0;
    private int activeProducts => monAns?.Count(m => m.TrangThai) ?? 0;
    private int inactiveProducts => monAns?.Count(m => !m.TrangThai) ?? 0;


    // Lifecycle
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    // Data loading
    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Load song song dữ liệu món ăn và chi tiết để tối ưu hiệu năng
            var monAnTask = MonAnService.GetAll();
            var chiTietTask = ChiTietMonAnService.GetAll();

            await Task.WhenAll(monAnTask, chiTietTask);

            monAns = monAnTask.Result ?? new List<MonAnDTO>();
            chiTietMonAns = chiTietTask.Result ?? new List<ChiTietMonAnDTO>();

            ApplySearchFilter();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }


    // Event handlers
    private void OnSearchInput(ChangeEventArgs e)
    {
        searchKeyword = e.Value?.ToString() ?? string.Empty;
        ApplySearchFilter();
    }

    private void ThemMonAnMoi()
    {
        Navigation.NavigateTo("/quanlysanpham/them-mon-an");
    }

    private void SuaMonAn(string id)
    {
        Navigation.NavigateTo($"/quanlysanpham/them-mon-an/{id}");
    }

    // HÀM XỬ LÝ MỚI: Mở Modal Xem Chi Tiết
    private void OpenViewDetailModal(MonAnDTO monAn)
    {
        selectedMonAn = monAn;
        // Lọc danh sách chi tiết từ bộ nhớ (in-memory) đã load ở LoadData()
        selectedMonAnDetails = chiTietMonAns?
            .Where(ct => string.Equals(ct.MonAnId, monAn.Id, StringComparison.OrdinalIgnoreCase))
            .ToList() ?? new List<ChiTietMonAnDTO>();

        isViewDetailModalOpen = true;
    }

    // HÀM XỬ LÝ MỚI: Đóng Modal
    private void CloseViewDetailModal()
    {
        isViewDetailModalOpen = false;
        selectedMonAn = null;
        selectedMonAnDetails = null;
    }

    private async Task XoaMonAn(string id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa món ăn này không?"))
        {
            var result = await MonAnService.Delete(id);
            if (result)
            {
                await LoadData();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Xóa món ăn thất bại!");
            }
        }
    }


    // Helpers
    private void ApplySearchFilter()
    {
        if (monAns == null)
        {
            filteredMonAns = new List<MonAnDTO>();
            return;
        }

        if (string.IsNullOrWhiteSpace(searchKeyword))
        {
            filteredMonAns = monAns.ToList();
        }
        else
        {
            var keyword = searchKeyword.ToLower().Trim();
            filteredMonAns = monAns.Where(m =>
                m.Ten?.ToLower().Contains(keyword) == true ||
                m.TheLoai?.ToLower().Contains(keyword) == true ||
                m.ThuongHieu?.ToLower().Contains(keyword) == true ||
                m.Mota?.ToLower().Contains(keyword) == true ||
                m.Id?.ToLower().Contains(keyword) == true
            ).ToList();
        }
        StateHasChanged();
    }

    private int GetVariantCount(string? monAnId)
    {
        if (string.IsNullOrWhiteSpace(monAnId) || chiTietMonAns == null)
        {
            return 0;
        }

        return chiTietMonAns.Count(ct => string.Equals(ct.MonAnId, monAnId, StringComparison.OrdinalIgnoreCase));
    }

    private string GetImageUrlWithCacheBusting(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return string.Empty;
        }

        // Thêm timestamp để tránh cache ảnh cũ
        var separator = imageUrl.Contains('?') ? '&' : '?';
        return $"{imageUrl}{separator}v={DateTime.UtcNow.Ticks}";
    }
}

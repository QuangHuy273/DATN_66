    // ============================
    // Helpers
    // ============================

    private string GetImageUrlWithCacheBusting(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return string.Empty;
        }

        // Thêm timestamp để tránh cache ảnh cũ
        var separator = imageUrl.Contains('?') ? '&' : '?';
        return $"{imageUrl}{separator}v={DateTime.UtcNow.Ticks}";
    }

    // A. TỔNG THỜI GIAN SỬ DỤNG (CỐ ĐỊNH)
    // Ngày sản xuất -> Hạn sử dụng
    private int GetTongSoNgaySuDung(ChiTietMonAnDTO ct)
    {
        if (ct == null || ct.HanSuDung <= ct.NgaySanXuat)
            return 0;

        return (ct.HanSuDung.Date - ct.NgaySanXuat.Date).Days + 1;
    }
    // B. SỐ NGÀY CÒN LẠI (ĐỘNG - CHUẨN TMĐT)
    // Hôm nay -> Hạn sử dụng (bao gồm hôm nay)
    private int GetSoNgayThoiHanSuDung(ChiTietMonAnDTO ct)
    {
        if (ct == null)
            return -1;

        var homNay = DateTime.Today;
        var han = ct.HanSuDung.Date;

        return (han - homNay).Days + 1;
    }
    // TEXT HIỂN THỊ
    private string GetThoiHanSuDungText(ChiTietMonAnDTO ct)
    {
        var soNgay = GetSoNgayThoiHanSuDung(ct);

        if (soNgay < 0)
            return "Đã hết hạn";

        if (soNgay == 0)
            return "Hết hạn hôm nay";

        if (soNgay == 1)
            return "Còn 1 ngày";

        return $"Còn {soNgay} ngày";
    }
    // STYLE THEO THỜI HẠN
    private string GetThoiHanSuDungStyle(ChiTietMonAnDTO ct)
    {
        var soNgay = GetSoNgayThoiHanSuDung(ct);

        if (soNgay <= 0)
            return "background-color: #f8f9fa; color: #6c757d;";

        if (soNgay > 14)
            return "background-color: #d4edda; color: #155724; border-color: #28a745;";

        if (soNgay >= 8)
            return "background-color: #fff3cd; color: #856404; border-color: #ffc107;";

        if (soNgay >= 4)
            return "background-color: #ffe5d0; color: #8b4513; border-color: #fd7e14;";

        return "background-color: #f8d7da; color: #721c24; border-color: #dc3545;";
    }
    // ICON THEO THỜI HẠN
    private string GetThoiHanSuDungIcon(ChiTietMonAnDTO ct)
    {
        var soNgay = GetSoNgayThoiHanSuDung(ct);

        if (soNgay <= 0)
            return "❌";

        if (soNgay > 14)
            return "🟢";

        if (soNgay >= 8)
            return "🟡";

        if (soNgay >= 4)
            return "🟠";

        return "🔴";
    }
    private int GetSoNgayCon(ChiTietMonAnDTO ct)
    {
        return GetSoNgayThoiHanSuDung(ct);
    }

    private string GetThoiHanSuDung(ChiTietMonAnDTO ct)
    {
        return GetThoiHanSuDungText(ct);
    }
}

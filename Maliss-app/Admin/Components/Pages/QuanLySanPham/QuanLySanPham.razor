    /// <summary>
    /// Tính toán danh sách số trang cần hiển thị
    /// Quy tắc:
    /// - Chỉ hiển thị tối đa 3 trang liên tiếp
    /// - Trang hiện tại luôn nằm ở vị trí đầu tiên trong dãy 3 trang
    /// - Luôn hiển thị ... và trang cuối nếu còn nhiều trang phía sau
    /// - Giá trị -1 trong danh sách đại diện cho dấu "..."
    /// </summary>
    private List<int> GetPageNumbers(int currentPage, int totalPages)
    {
        var pageNumbers = new List<int>();

        if (totalPages <= 1)
            return pageNumbers;

        // Nếu tổng số trang <= 5, hiển thị tất cả
        if (totalPages <= 5)
        {
            for (int i = 1; i <= totalPages; i++)
            {
                pageNumbers.Add(i);
            }
            return pageNumbers;
        }

        // Tính toán dãy 3 trang liên tiếp (trang hiện tại ở vị trí đầu tiên)
        int startPage = currentPage;
        int endPage = Math.Min(currentPage + 2, totalPages);

        // Nếu trang hiện tại là 1 hoặc 2, hiển thị trang 1, 2, 3
        if (currentPage <= 2)
        {
            startPage = 1;
            endPage = 3;
        }

        // Thêm các trang vào danh sách
        for (int i = startPage; i <= endPage; i++)
        {
            pageNumbers.Add(i);
        }

        // Nếu endPage không phải là trang cuối, thêm ... và trang cuối
        if (endPage < totalPages)
        {
            pageNumbers.Add(-1); // Dấu ...
            pageNumbers.Add(totalPages);
        }

        return pageNumbers;
    }


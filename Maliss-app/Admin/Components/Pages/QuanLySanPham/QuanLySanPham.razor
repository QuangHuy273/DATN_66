@page "/quan-ly-san-pham"
@page "/quanlysanpham"
@using Admin.Service.IService
@using API.Models.DTO
@inject IMonAnService MonAnService
@inject IChiTietMonAnService ChiTietMonAnService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Quản Lý Sản Phẩm</PageTitle>

<link href="css/QuanLySanPham.css" rel="stylesheet" />

<div class="quan-ly-san-pham-container">
    <div class="header-section">
        <h2>Quản Lý Sản Phẩm</h2>
        <button class="btn btn-primary" @onclick="ThemMonAnMoi">
            <i class="bi bi-plus-circle"></i> Thêm Món Ăn Mới
        </button>
    </div>

    <div class="search-section">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" 
                   placeholder="Tìm kiếm sản phẩm..." 
                   @bind="searchKeyword" 
                   @oninput="OnSearchInput" 
                   class="search-input" />
        </div>
    </div>

    <div class="stats-section">
        <div class="stat-card">
            <div class="stat-icon total">
                <i class="bi bi-box-seam"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Tổng Sản Phẩm</div>
                <div class="stat-value">@totalProducts</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon active">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Đang Hoạt Động</div>
                <div class="stat-value">@activeProducts</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon inactive">
                <i class="bi bi-x-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Tạm Dừng</div>
                <div class="stat-value">@inactiveProducts</div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading">
            <p>Đang tải dữ liệu...</p>
        </div>
    }
    else if (filteredMonAns == null || !filteredMonAns.Any())
    {
        <div class="empty-state">
            <p>@(string.IsNullOrWhiteSpace(searchKeyword) ? "Chưa có món ăn nào. Hãy thêm món ăn mới!" : "Không tìm thấy sản phẩm nào phù hợp.")</p>
        </div>
    }
    else
    {
        <div class="product-grid row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-4">
            @foreach (var monAn in filteredMonAns)
            {
                <div class="col">
                    <div class="card product-card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(monAn.AnhDaTai))
                        {
                            <img src="@GetImageUrlWithCacheBusting(monAn.AnhDaTai)"
                                 alt="Ảnh @monAn.Ten"
                                 class="card-img-top product-cover" />
                        }
                        else
                        {
                            <div class="product-cover placeholder d-flex flex-column justify-content-center align-items-center text-muted">
                                <i class="bi bi-image fs-1 mb-2"></i>
                                <span>Chưa có ảnh</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column gap-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small d-block mb-1" style="font-weight: 600; letter-spacing: 0.5px;">#@monAn.Id</span>
                                    <h5 class="card-title mb-0">@monAn.Ten</h5>
                                </div>
                                <span class="badge status-badge @(monAn.TrangThai ? "bg-success" : "bg-secondary")">
                                    @(monAn.TrangThai ? "Hoạt động" : "Tạm dừng")
                                </span>
                            </div>

                            <div class="d-flex flex-column gap-2 text-muted small">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-semibold text-dark">Danh mục</span>
                                    <span>@(monAn.TheLoai ?? "Chưa có danh mục")</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="fw-semibold text-dark">Số lượng chi tiết</span>
                                    <span>@GetVariantCount(monAn.Id) biến thể</span>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-info flex-fill" @onclick="() => SuaMonAn(monAn.Id)">
                                    <i class="bi bi-pencil me-1"></i> Sửa
                                </button>
                                <button class="btn btn-sm btn-warning flex-fill" @onclick="() => ThemChiTiet(monAn.Id)">
                                    <i class="bi bi-plus-circle me-1"></i> Chi tiết
                                </button>
                                <button class="btn btn-sm btn-danger flex-fill" @onclick="() => XoaMonAn(monAn.Id)">
                                    <i class="bi bi-trash me-1"></i> Xóa
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    // ============================
    // State
    // ============================
    private List<MonAnDTO>? monAns;
    private List<MonAnDTO>? filteredMonAns;
    private List<ChiTietMonAnDTO>? chiTietMonAns;
    private bool isLoading = true;
    private string searchKeyword = string.Empty;

    
    // Computed properties
    
    private int totalProducts => monAns?.Count ?? 0;
    private int activeProducts => monAns?.Count(m => m.TrangThai) ?? 0;
    private int inactiveProducts => monAns?.Count(m => !m.TrangThai) ?? 0;

    
    // Lifecycle
    
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    
    // Data loading
    
    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var monAnTask = MonAnService.GetAll();
            var chiTietTask = ChiTietMonAnService.GetAll();

            await Task.WhenAll(monAnTask, chiTietTask);

            monAns = monAnTask.Result ?? new List<MonAnDTO>();
            chiTietMonAns = chiTietTask.Result ?? new List<ChiTietMonAnDTO>();

            ApplySearchFilter();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    
    // Event handlers
    
    private void OnSearchInput(ChangeEventArgs e)
    {
        searchKeyword = e.Value?.ToString() ?? string.Empty;
        ApplySearchFilter();
    }

    private void ThemMonAnMoi()
    {
        Navigation.NavigateTo("/quanlysanpham/them-mon-an");
    }

    private void SuaMonAn(string id)
    {
        Navigation.NavigateTo($"/quanlysanpham/them-mon-an/{id}");
    }

    private void ThemChiTiet(string monAnId)
    {
        Navigation.NavigateTo($"/quanlysanpham/them-chi-tiet-mon-an/{monAnId}");
    }

    private async Task XoaMonAn(string id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa món ăn này không?"))
        {
            var result = await MonAnService.Delete(id);
            if (result)
            {
                await LoadData();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Xóa món ăn thất bại!");
            }
        }
    }


    // Helpers
    
    private void ApplySearchFilter()
    {
        if (monAns == null)
        {
            filteredMonAns = new List<MonAnDTO>();
            return;
        }

        if (string.IsNullOrWhiteSpace(searchKeyword))
        {
            filteredMonAns = monAns.ToList();
        }
        else
        {
            var keyword = searchKeyword.ToLower().Trim();
            filteredMonAns = monAns.Where(m =>
                m.Ten?.ToLower().Contains(keyword) == true ||
                m.TheLoai?.ToLower().Contains(keyword) == true ||
                m.ThuongHieu?.ToLower().Contains(keyword) == true ||
                m.Mota?.ToLower().Contains(keyword) == true ||
                m.Id?.ToLower().Contains(keyword) == true
            ).ToList();
        }
        StateHasChanged();
    }

    private int GetVariantCount(string? monAnId)
    {
        if (string.IsNullOrWhiteSpace(monAnId) || chiTietMonAns == null)
        {
            return 0;
        }

        return chiTietMonAns.Count(ct => string.Equals(ct.MonAnId, monAnId, StringComparison.OrdinalIgnoreCase));
    }

    private string GetImageUrlWithCacheBusting(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return string.Empty;
        }

        // Thêm timestamp để tránh cache ảnh cũ
        var separator = imageUrl.Contains('?') ? '&' : '?';
        return $"{imageUrl}{separator}v={DateTime.UtcNow.Ticks}";
    }
}

@page "/quan-ly-san-pham"
@page "/quanlysanpham"
@using Admin.Service.IService
@using API.Models.DTO
@inject IMonAnService MonAnService
@inject IChiTietMonAnService ChiTietMonAnService
@inject IApiService ApiService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Quản Lý Sản Phẩm</PageTitle>

<link href="css/QuanLySanPham.css" rel="stylesheet" />

<div class="quan-ly-san-pham-container">
    <div class="header-section">
        <h2><i class="bi bi-box-seam"></i> Quản Lý Sản Phẩm</h2>
        <button class="btn btn-primary" @onclick="ThemMonAnMoi">
            <i class="bi bi-plus-circle"></i> Thêm Món Ăn Mới
        </button>
    </div>

    <!-- KHU VỰC TÌM KIẾM + BỘ LỌC -->
    <div class="search-filter-section">
        <div class="search-filter-row">

            <!-- Ô tìm kiếm -->
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Tìm kiếm sản phẩm..."
                       @bind="filterRequest.Keyword"
                       @oninput="OnKeywordChange"
                       class="search-input" />
            </div>

            <!-- CỤM NÚT (đẩy về phải) -->
            <div class="filter-actions ms-auto">

                <!-- Nút xóa bộ lọc (bên trái) -->
                @if (HasActiveFilters())
                {
                    <button class="btn-filter btn-clear"
                            @onclick="ClearFilters"
                            title="Xóa tất cả bộ lọc">
                            <span>Xóa tất cả bộ lọc</span>
                        <i class="bi bi-x-circle"></i>
                    </button>
                }

                <!-- Nút bộ lọc -->
                <button class="btn-filter btn-main"
                        @onclick="OpenFilterModal">
                    <i class="bi bi-funnel-fill"></i>
                    <span>Bộ lọc</span>

                    @if (HasActiveFilters())
                    {
                        <span class="badge">@CountActiveFilters()</span>
                    }
                </button>
            </div>

        </div>
    </div>
    <div class="stats-section">
        <div class="stat-card">
            <div class="stat-icon total">
                <i class="bi bi-box-seam"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Tổng Sản Phẩm</div>
                <div class="stat-value">@totalProducts</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon active">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Đang Hoạt Động</div>
                <div class="stat-value">@activeProducts</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon inactive">
                <i class="bi bi-x-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Tạm Dừng</div>
                <div class="stat-value">@inactiveProducts</div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading">
            <p>Đang tải dữ liệu...</p>
        </div>
    }
    else if (filterResponse == null || !filterResponse.MonAns.Any())
    {
        <div class="empty-state">
            <p>@(HasActiveFilters() ? "Không tìm thấy sản phẩm nào phù hợp với bộ lọc." : "Chưa có món ăn nào. Hãy thêm món ăn mới!")</p>
        </div>
    }
    else
    {
        <div class="product-grid row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-4">
            @foreach (var item in filterResponse.MonAns)
            {
                var monAn = item.MonAn;
                <div class="col">
                    <div class="card product-card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(monAn.AnhDaTai))
                        {
                            <img src="@GetImageUrlWithCacheBusting(monAn.AnhDaTai)"
                                 alt="Ảnh @monAn.Ten"
                                 class="card-img-top product-cover" />
                        }
                        else
                        {
                            <div class="product-cover placeholder d-flex flex-column justify-content-center align-items-center text-muted">
                                <i class="bi bi-image fs-1 mb-2"></i>
                                <span>Chưa có ảnh</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column gap-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="text-muted small d-block mb-1" style="font-weight: 600; letter-spacing: 0.5px;">#@monAn.Id</span>
                                    <h5 class="card-title mb-0 text-truncate" style="max-width: 180px;" title="@monAn.Ten">@monAn.Ten</h5>
                                </div>
                                <span class="badge status-badge @(monAn.TrangThai ? "bg-success" : "bg-secondary")">
                                    @(monAn.TrangThai ? "Hoạt động" : "Tạm dừng")
                                </span>
                            </div>

                            <div class="d-flex flex-column gap-2 text-muted small">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-semibold text-dark">Danh mục</span>
                                    <span>@(monAn.TheLoai ?? "Chưa có danh mục")</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold text-dark">Số lượng chi tiết</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <span>@item.TotalVariantCount biến thể</span>
                                        @if (item.MatchingVariantCount > 0 && filterRequest.HasChiTietFilter())
                                        {
                                            <span class="badge bg-primary" style="font-size: 10px;" title="Số biến thể phù hợp với bộ lọc">
                                                @item.MatchingVariantCount phù hợp
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                <button class="btn btn-sm btn-info flex-fill" @onclick="() => OpenViewDetailModal(item)">
                                    <i class="bi bi-eye"></i> Xem Chi Tiết
                                </button>
                                <button class="btn btn-sm btn-warning flex-fill" @onclick="() => SuaMonAn(monAn.Id)">
                                    <i class="bi bi-pencil"></i> Chỉnh Sửa
                                </button>
                                <button class="btn btn-sm btn-danger flex-fill" @onclick="() => XoaMonAn(monAn.Id)">
                                    <i class="bi bi-trash"></i> Xóa
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PHÂN TRANG -->
        @if (filterResponse.TotalPages > 1)
        {
            <div class="pagination-section mt-4">
                <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
                    <!-- Nút Trang đầu -->
                    <button class="btn btn-pagination btn-nav" 
                            @onclick="() => GoToPage(1)" 
                            disabled="@(filterRequest.PageIndex <= 1)"
                            title="Trang đầu">
                        <i class="bi bi-chevron-double-left"></i>
                        <span class="btn-text">Trang đầu</span>
                    </button>
                    
                    <!-- Nút Trang trước -->
                    <button class="btn btn-pagination btn-nav" 
                            @onclick="() => GoToPage((filterRequest.PageIndex ?? 1) - 1)" 
                            disabled="@(filterRequest.PageIndex <= 1)"
                            title="Trang trước">
                        <i class="bi bi-chevron-left"></i>
                        <span class="btn-text">Trang trước</span>
                    </button>

                    <!-- Hiển thị các số trang -->
                    @{
                        var currentPage = filterRequest.PageIndex ?? 1;
                        var totalPages = filterResponse.TotalPages;
                        var pageNumbers = GetPageNumbers(currentPage, totalPages);
                    }

                    @foreach (var pageNum in pageNumbers)
                    {
                        if (pageNum == -1)
                        {
                            <!-- Hiển thị dấu ... -->
                            <span class="pagination-ellipsis">...</span>
                        }
                        else
                        {
                            <!-- Hiển thị số trang -->
                            <button class="btn btn-pagination btn-page @(pageNum == currentPage ? "active" : "")" 
                                    @onclick="() => GoToPage(pageNum)"
                                    disabled="@(pageNum == currentPage)">
                                @pageNum
                            </button>
                        }
                    }

                    <!-- Nút Trang tiếp -->
                    <button class="btn btn-pagination btn-nav" 
                            @onclick="() => GoToPage((filterRequest.PageIndex ?? 1) + 1)" 
                            disabled="@(filterRequest.PageIndex >= filterResponse.TotalPages)"
                            title="Trang tiếp">
                        <span class="btn-text">Trang tiếp</span>
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    
                    <!-- Nút Trang cuối -->
                    <button class="btn btn-pagination btn-nav" 
                            @onclick="() => GoToPage(filterResponse.TotalPages)" 
                            disabled="@(filterRequest.PageIndex >= filterResponse.TotalPages)"
                            title="Trang cuối">
                        <span class="btn-text">Trang cuối</span>
                        <i class="bi bi-chevron-double-right"></i>
                    </button>
                </div>
                
                <!-- Thông tin tổng quan -->
                <div class="text-center mt-3">
                    <span class="pagination-info">
                        Trang <strong>@filterResponse.PageIndex</strong> / <strong>@filterResponse.TotalPages</strong>
                        <span class="text-muted ms-2">(@filterResponse.TotalCount món ăn)</span>
                    </span>
                </div>
            </div>
        }
    }
</div>

<!-- MODAL BỘ LỌC -->
@if (isFilterModalOpen)
{
    <div class="modal-backdrop show" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1040;"></div>

    <div class="modal show d-block" tabindex="-1" style="z-index: 1050; overflow-y: auto;">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: #4f46e5; color: white;">
                    <h5 class="modal-title"><i class="bi bi-funnel-fill me-2"></i>Bộ Lọc Nâng Cao</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseFilterModal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                    <!-- LỌC THEO MÓN ĂN -->
                    <div class="card mb-3">
                        <div class="card-header" style="background: #f8fafc; font-weight: 600;">
                            <i class="bi bi-box-seam me-2" style="color: #4f46e5;"></i>Lọc Theo Món Ăn
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Trạng thái món ăn</label>
                                    <select class="form-select" @onchange="@((e) => OnTrangThaiMonAnChange(e.Value?.ToString()))">
                                        <option value="" selected="@(!tempFilter.TrangThaiMonAn.HasValue)">-- Tất cả --</option>
                                        <option value="true" selected="@(tempFilter.TrangThaiMonAn == true)">Hoạt động</option>
                                        <option value="false" selected="@(tempFilter.TrangThaiMonAn == false)">Tạm dừng</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Thể loại</label>
                                    <select class="form-select" @onchange="@((e) => OnTheLoaiChange(e.Value?.ToString()))">
                                        <option value="" selected="@(!tempFilter.TheLoaiId.HasValue)">-- Tất cả --</option>
                                        @foreach (var tl in theLoais)
                                        {
                                            <option value="@tl.Id" selected="@(tempFilter.TheLoaiId == tl.Id)">@tl.Ten</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Thương hiệu</label>
                                    <select class="form-select" @onchange="@((e) => OnThuongHieuChange(e.Value?.ToString()))">
                                        <option value="" selected="@(!tempFilter.ThuongHieuId.HasValue)">-- Tất cả --</option>
                                        @foreach (var th in thuongHieus)
                                        {
                                            <option value="@th.Id" selected="@(tempFilter.ThuongHieuId == th.Id)">@th.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- LỌC THEO CHI TIẾT MÓN ĂN -->
                    <div class="card mb-3">
                        <div class="card-header" style="background: #f8fafc; font-weight: 600;">
                            <i class="bi bi-list-ul me-2" style="color: #4f46e5;"></i>Lọc Theo Chi Tiết Món Ăn
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Trạng thái chi tiết</label>
                                    <select class="form-select" @onchange="@((e) => OnTrangThaiChiTietChange(e.Value?.ToString()))">
                                        <option value="" selected="@(!tempFilter.TrangThaiChiTiet.HasValue)">-- Tất cả --</option>
                                        <option value="true" selected="@(tempFilter.TrangThaiChiTiet == true)">Hoạt động</option>
                                        <option value="false" selected="@(tempFilter.TrangThaiChiTiet == false)">Tạm dừng</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Loại vị</label>
                                    <select class="form-select" @onchange="@((e) => OnLoaiViChange(e.Value?.ToString()))">
                                        <option value="" selected="@(!tempFilter.LoaiViId.HasValue)">-- Tất cả --</option>
                                        @foreach (var lv in loaiVis)
                                        {
                                            <option value="@lv.Id" selected="@(tempFilter.LoaiViId == lv.Id)">@lv.Ten</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Kích cỡ</label>
                                    <select class="form-select" @onchange="@((e) => OnKichCoChange(e.Value?.ToString()))">
                                        <option value="" selected="@(!tempFilter.KichCoId.HasValue)">-- Tất cả --</option>
                                        @foreach (var kc in kichCos)
                                        {
                                            <option value="@kc.Id" selected="@(tempFilter.KichCoId == kc.Id)">@kc.Ten</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Nhà cung cấp</label>
                                    <select class="form-select" @onchange="@((e) => OnNhaCungCapChange(e.Value?.ToString()))">
                                        <option value="" selected="@(!tempFilter.NhaCungCapId.HasValue)">-- Tất cả --</option>
                                        @foreach (var ncc in nhaCungCaps)
                                        {
                                            <option value="@ncc.Id" selected="@(tempFilter.NhaCungCapId == ncc.Id)">@ncc.Ten</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Nguyên liệu</label>
                                    <select class="form-select" @onchange="@((e) => OnNguyenLieuChange(e.Value?.ToString()))">
                                        <option value="" selected="@(!tempFilter.NguyenLieuId.HasValue)">-- Tất cả --</option>
                                        @foreach (var nl in nguyenLieus)
                                        {
                                            <option value="@nl.Id" selected="@(tempFilter.NguyenLieuId == nl.Id)">@nl.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <!-- Lọc theo giá -->
                            <div class="row">
                                <div class="col-12 mb-2">
                                    <label class="form-label fw-bold">Khoảng giá</label>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <input type="number" class="form-control" placeholder="Từ (VNĐ)" @bind="tempFilter.GiaFrom" min="0" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <input type="number" class="form-control" placeholder="Đến (VNĐ)" @bind="tempFilter.GiaTo" min="0" />
                                </div>
                            </div>

                            <!-- Lọc theo số lượng -->
                            <div class="row">
                                <div class="col-12 mb-2">
                                    <label class="form-label fw-bold">Khoảng số lượng</label>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <input type="number" class="form-control" placeholder="Từ" @bind="tempFilter.SoLuongFrom" min="0" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <input type="number" class="form-control" placeholder="Đến" @bind="tempFilter.SoLuongTo" min="0" />
                                </div>
                            </div>

                            <!-- Lọc theo ngày sản xuất -->
                            <div class="row">
                                <div class="col-12 mb-2">
                                    <label class="form-label fw-bold">Ngày sản xuất</label>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <input type="date" class="form-control" @bind="tempFilter.NgaySanXuatFrom" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <input type="date" class="form-control" @bind="tempFilter.NgaySanXuatTo" />
                                </div>
                            </div>

                            <!-- Lọc theo hạn sử dụng -->
                            <div class="row">
                                <div class="col-12 mb-2">
                                    <label class="form-label fw-bold">Hạn sử dụng</label>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <input type="date" class="form-control" @bind="tempFilter.HanSuDungFrom" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <input type="date" class="form-control" @bind="tempFilter.HanSuDungTo" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="background: #f8fafc;">
                    <button type="button" class="btn btn-secondary" @onclick="CloseFilterModal">
                        <i class="bi bi-x-lg"></i> Hủy
                    </button>
                    <button type="button" class="btn btn-outline-danger" @onclick="ClearTempFilters">
                        <i class="bi bi-arrow-counterclockwise"></i> Đặt Lại
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="ApplyFilters">
                        <i class="bi bi-check-lg"></i> Áp Dụng
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL XEM CHI TIẾT (MỚI - MỞ RỘNG) -->
@if (isViewDetailModalOpen && selectedMonAnItem != null)
{
    <!-- Backdrop -->
    <div class="modal-backdrop show" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1040;"></div>

    <div class="modal show d-block" tabindex="-1" style="z-index: 1050; overflow-y: auto;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: #4f46e5; color: white;">
                    <h5 class="modal-title"><i class="bi bi-eye me-2"></i>Chi Tiết Món Ăn</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseViewDetailModal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="max-height: 80vh; overflow-y: auto;">
                    <!-- ===== PHẦN 1: THÔNG TIN CHUNG MÓN ĂN ===== -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                            <h6 class="mb-0 fw-bold" style="color: #1e293b;"><i class="bi bi-info-circle me-2" style="color: #4f46e5;"></i>Thông Tin Món Ăn</h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <!-- Cột ảnh món ăn chính -->
                                <div class="col-md-4 text-center mb-3 mb-md-0">
                                    @if (!string.IsNullOrWhiteSpace(selectedMonAnItem.MonAn.AnhDaTai))
                                    {
                                        <img src="@GetImageUrlWithCacheBusting(selectedMonAnItem.MonAn.AnhDaTai)" 
                                             class="img-fluid rounded shadow-sm" 
                                             alt="Ảnh món ăn" 
                                             style="max-height: 250px; object-fit: cover; width: 100%;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="height: 250px;">
                                            <div class="text-center">
                                                <i class="bi bi-image fs-1 text-muted"></i>
                                                <p class="text-muted mt-2 mb-0">Không có ảnh</p>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Cột thông tin chi tiết -->
                                <div class="col-md-8">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-tag me-1"></i>Tên món ăn</label>
                                            <input type="text" class="form-control" disabled value="@selectedMonAnItem.MonAn.Ten" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-collection me-1"></i>Danh mục</label>
                                            <input type="text" class="form-control" disabled value="@(selectedMonAnItem.MonAn.TheLoai ?? "N/A")" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-award me-1"></i>Thương hiệu</label>
                                            <input type="text" class="form-control" disabled value="@(selectedMonAnItem.MonAn.ThuongHieu ?? "N/A")" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-toggle-on me-1"></i>Trạng thái</label>
                                            <input type="text" class="form-control" disabled 
                                                   value="@(selectedMonAnItem.MonAn.TrangThai ? "Đang hoạt động" : "Tạm dừng")"
                                                   style="@(selectedMonAnItem.MonAn.TrangThai ? "color: #28a745; font-weight: 600;" : "color: #6c757d; font-weight: 600;")" />
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-secondary mb-1"><i class="bi bi-file-text me-1"></i>Mô tả</label>
                                        <textarea class="form-control" disabled rows="4" style="resize: none;">@(selectedMonAnItem.MonAn.Mota ?? "Chưa có mô tả")</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ===== PHẦN 2: DANH SÁCH BIẾN THỂ ===== -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                            <h6 class="mb-0 fw-bold" style="color: #1e293b;">
                                <i class="bi bi-list-ul me-2" style="color: #4f46e5;"></i>Danh Sách Biến Thể Chi Tiết
                                @if (selectedMonAnItem.MatchingVariantCount > 0)
                                {
                                    <span class="badge bg-primary ms-2">@selectedMonAnItem.MatchingVariantCount / @selectedMonAnItem.TotalVariantCount phù hợp</span>
                                }
                            </h6>

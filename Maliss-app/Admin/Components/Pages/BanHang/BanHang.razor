@page "/banhang"
@layout Layout.MainLayout
@using API.HeThong.IHeThong
@using API.Models.ViewModels.BanHang
@using API.Models.DTO
@using AutoMapper
@inject NavigationManager Nav
@inject IChiTietMonAnService GetChiTietMonAnService
@implements IDisposable
@inject IXuLyDiaChi xuLyDiaChi
@inject IJSRuntime JS
@inject IApiService apiService
@inject IMapper _mapper
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IHoaDonService HoaDonService
@inject IVnPayService vnPayService
<link href="css/BanHang.css" rel="stylesheet" />
<div class="sell-container">
    <!-- Tabs đơn hàng -->
    <div class="order-tabs">
        @foreach (var order in Orders.Select((value, index) => new { value, index }))
        {
            <div class="order-tab @(order.index == CurrentOrderIndex ? "active" : "")" @onclick="@(() => SwitchOrder(order.index))">
                Đơn hàng @(order.index + 1)
                @if (order.value.Products.Count > 0)
                {
                    <span class="order-qty-badge">@order.value.Products.Sum(p => p.SoLuongDat)</span>
                }
                <span class="close" @onclick="() => RemoveOrderSafe(order.index)">×</span>
            </div>
        }

        <button class="create-order-btn" @onclick="CreateOrder">+ Tạo đơn hàng</button>
    </div>
    @if (Orders.Count == 0)
    {
        <div class="empty-order-notice">
            Bạn chưa có đơn hàng nào.
            <button class="create-order-btn" @onclick="CreateOrder">+ Tạo đơn hàng đầu tiên</button>
        </div>
    }

    <!-- Thanh công cụ sản phẩm -->
    @if (CurrentOrder != null)
    {
        <div class="order-actions">
            <div class="order-list-title">Sản phẩm</div>
            <div class="order-actions-buttons">
                <button class="qr-btn" @onclick="ScanQRCode">📷 Quét QR sản phẩm</button>
                <button class="add-btn" @onclick="() => IsProductModalVisible = true">Thêm sản phẩm</button>
                <ProductSelect Visible="@IsProductModalVisible"
                               OnAddProduct="HandleAddProduct"
                               OnClose="@(() => IsProductModalVisible = false)" />
            </div>
        </div>
    }
    @if (CurrentOrder != null)
    {
        <!-- Danh sách sản phẩm trong đơn hàng -->
        <div class="order-list @OrderListClass">
            @if (CurrentOrder?.Products.Count == 0)
            {
                <div>Chưa có sản phẩm nào trong đơn hàng</div>
            }
            else
            {
                @foreach (var product in CurrentOrder.Products)
                {
                    <div class="order-item">
                        <img src="@(product.DanhSachAnh?.FirstOrDefault()?.DuongDan ?? "")" class="order-img" />
                        <div class="item-info">
                            <div class="order-name">@product.Ten</div>

                            <div class="order-code">
                                Mã: @product.MonAnId
                            </div>

                            <div class="order-attributes">
                                <div class="order-size">Vị: <strong>@product.LoaiVi</strong></div>
                                <div class="order-size">Cỡ: <strong>@product.KichCo</strong></div>
                                <div class="order-size">Nguyên Liệu: <strong>@product.NguyenLieu</strong></div>
                            </div>

                            <div class="order-price">
                                @FormatMoney(product.Gia)
                            </div>
                        </div>

                        <div class="order-qty">
                            <button class="decrease-btn" @onclick="() => DecreaseQuantity(product)">-</button>
                            <input class="qty-input"
                                   type="number"
                                   min="1"
                                   max="@product.Soluong"
                                   @bind="product.SoLuongDat"
                                   @bind:after="() => OnQuantityChanged(product)"
                                   @onclick:stopPropagation
                                   style="pointer-events: auto; cursor: text; user-select: auto; -webkit-user-select: auto;" />
                            <button class="increase-btn" @onclick="() => IncreaseQuantity(product)">+</button>
                        </div>
                        <div class="order-total">@FormatMoney(product.SoLuongDat * (int)product.Gia)</div>
                        <button class="order-remove" @onclick="() => RemoveProduct(product)">×</button>
                    </div>
                }

            }
        </div>
    }

    <!-- Khách hàng -->
    @if (CurrentOrder != null)
    {
        <div class="customer-header">
            <span class="customer-title">
                Khách hàng: <span class="customer-name">@(CurrentOrder?.Customer?.HoTen ?? "Khách lẻ") </span>
            </span>
            <button class="choose-customer-btn" @onclick="() => IsCustomerModalVisible = true">+ CHỌN KHÁCH HÀNG</button>
            <CustomerSelect Visible="@IsCustomerModalVisible"
                            OnCustomerSelected="HandleCustomerSelected"
                            OnClose="@(() => IsCustomerModalVisible = false)" />
            @if (CurrentOrder?.Customer != null)
            {
                <button class="reset-customer-btn" @onclick="@Khachle"
                        style=" margin-left:8px; background:#e0e0e0; color:#333; border:none; border-radius:6px; padding:8px 16px; cursor:pointer; font-weight:500;height:40px;">
                    Đổi về khách lẻ
                </button>
            }
        </div>

    }


    <!-- Footer đặt hàng -->
    @if (CurrentOrder != null)
    {
        <div class="order-footer">
            <div class="order-info">
                <div class="voucher-area">
                    <label style="display: none;visibility: hidden;" for="voucher" class="sr-only">Phiếu giảm giá</label>
                    <input style="cursor:pointer" @onchange="OnVoucherChange" list="PhieuGiamGia" id="voucher" type="text" class="voucher-input" placeholder="Phiếu giảm giá" />
                    <datalist id="PhieuGiamGia">
                        @foreach (var x in vouchers)
                        {
                            <option>@x.Ten</option>
                        }
                    </datalist>
                    <label style="display: none;visibility: hidden;" for="discount" class="sr-only">Phần trăm giảm</label>
                    <input disabled type="text" value="@($"{DiscountPercent} %")" class="discount-input" />

                </div>

                <div class="order-summary">
                    <div class="order-row">
                        <span>Tiền hàng</span>
                        <span>@FormatMoney(Subtotal)</span>
                    </div>
                    <div class="order-row">
                        <span>Giảm giá</span>
                        <span>@FormatMoney(DiscountAmount)</span>
                    </div>
                    <div class="order-row total">
                        <span>Tổng số tiền</span>
                        <span>@FormatMoney(TotalAmount)</span>
                    </div>
                    <div class="payment-method">
                        <h4>Phương thức thanh toán</h4>
                        <div class="btn-group">
                            <button type="button"
                                    class="btn @(PaymentMethod == "Cash" ? "btn-primary" : "btn-outline-primary")"
                                    @onclick='() => SelectPaymentMethod("Cash")'>
                                💵 Tiền mặt
                            </button>

                            <button type="button"
                                    class="btn @(PaymentMethod == "QR" ? "btn-success" : "btn-outline-success")"
                                    @onclick='() => SelectPaymentMethod("QR")'>
                                📱 Quét QR
                            </button>
                        </div>
                    </div>
                    @if (PaymentMethod == "Cash")
                    {
                        <div class="cash-payment">
                            <label>Khách trả:</label>
                            <input type="number" min="0" step="0.01" @bind="CustomerPay" @bind:event="oninput" />
                            <div>
                                @if (CustomerPay < TotalAmount)
                                {
                                    <strong>Khách còn thiếu:</strong> 
                                    @FormatMoney(TotalAmount - CustomerPay)
                                }
                                else
                                {
                                    <strong>Tiền thừa:</strong> 
                                    @FormatMoney(CustomerPay - TotalAmount)
                                }
                            </div>
                        </div>
                    }
                    <button class="confirm-btn" @onclick="ThanhToan">XÁC NHẬN ĐẶT HÀNG</button>
                </div>
            </div>
        </div>
    }
</div>


@code {

    private string OrderListClass => CurrentOrder?.Products?.Count == 0 ? "empty" : "";

    //  Dữ liệu đơn hàng
    private List<Order> Orders = new();
    private int CurrentOrderIndex = 0;
    private Order? CurrentOrder =>
    Orders != null && Orders.Count > 0 && CurrentOrderIndex < Orders.Count
    ? Orders[CurrentOrderIndex]
    : null;

    private decimal _CustomerPay;
    private decimal CustomerPay
    {
        get => _CustomerPay;
        set
        {
            _CustomerPay = value;
            StateHasChanged();
        }
    }

    //  Tính toán đơn hàng
    private decimal DiscountPercent { get; set; } = 0;

    private decimal Subtotal => CurrentOrder?.Products?.Sum(p => p.SoLuongDat * p.Gia) ?? 0m;

    private decimal DiscountAmount => (Subtotal * DiscountPercent) / 100m;

    private decimal TotalAmount => Subtotal - DiscountAmount;

    private decimal DeficitAmount => CustomerPay - TotalAmount;

    private List<ChiTietMonAnDTO> Products = new();
    private List<MonAnDTO> allProducts = new();
    private List<Voucher> vouchers = new();
    private string PaymentMethod { get; set; } = "Cash";


    // 🛒 Hành động
    private async Task CreateOrder()
    {

        if (Orders.Count >= 5)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                toast = true,
                position = "top-end",
                icon = "info",
                title = "Bạn đã tạo tối đa 5 đơn hàng.",
                showConfirmButton = false,
                timer = 3000,
                timerProgressBar = true
            });
            return;
        }
       
        await ReloadProductStock();

        Orders.Add(new Order()
        {
            ThoiGianTao = DateTime.Now
        });
        CurrentOrderIndex = Orders.Count - 1;
        StateHasChanged();
        await SaveOrdersToStorage();
    }
    // reset về kho khi xóa đơn
    private async Task RestoreStockForOrder(Order order)
    {
        if (order?.Products == null) return;

        foreach (var product in order.Products)
        {
            var chiTiet = await apiService.GetbyId<ChiTietMonAn, Guid>(product.Id, "ChiTietMonAn");
            if (chiTiet != null)
            {
                chiTiet.Soluong += product.SoLuongDat;
                await apiService.PutAsync<ChiTietMonAn>("ChiTietMonAn", chiTiet);
            }
        }
    }
    // xóa đơn
    private async Task RemoveOrder(int index)
    {
        if (index < 0 || index >= Orders.Count) return;

        var order = Orders[index];

      
        await RestoreStockForOrder(order);

        Orders.RemoveAt(index);

        if (index <= CurrentOrderIndex && CurrentOrderIndex > 0)
            CurrentOrderIndex--;

        if (CurrentOrderIndex >= Orders.Count)
            CurrentOrderIndex = Orders.Count - 1;

        await RefreshProductData();      
        await SaveOrdersToStorage();
        StateHasChanged();
    }

    private bool IsRemovingOrder = false;

    private async Task RemoveOrderSafe(int index)
    {
        var result = await JS.InvokeAsync<SwalResult>("Swal.fire", new
        {
            title = "Xác nhận xóa đơn hàng",
            text = "Bạn có chắc muốn xác nhận đơn hàng này?",
            icon = "question",
            showCancelButton = true,
            confirmButtonText = "Xác nhận",
            cancelButtonText = "Huỷ"
        });

        if (result.IsConfirmed)
        {
            if (IsRemovingOrder) return;
            IsRemovingOrder = true;

            await RemoveOrder(index);
            await Task.Delay(200);
            IsRemovingOrder = false;
        }
    }


    private async Task SwitchOrder(int index)
    {
        CurrentOrderIndex = index;
        CustomerPay = 0;
        PaymentMethod = CurrentOrder.ThongTinHoaDon.PhuongThucThanhToan == true ? "QR" : "Cash";
        await SaveOrdersToStorage();
    }


    private async Task IncreaseQuantity(ChiTietMonAnDTO product)
    {
        var chiTiet = await apiService.GetbyId<ChiTietMonAn, Guid>(product.Id, "ChiTietMonAn");
        if (chiTiet == null || chiTiet.Soluong <= 0)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                icon = "info",
                title = "Đã hết hàng"
            });
            return;
        }

        //  TRỪ KHO DB
        chiTiet.Soluong--;
        if (!await apiService.PutAsync<ChiTietMonAn>("ChiTietMonAn", chiTiet)) return;

        //  CẬP NHẬT VIEW NGAY LẬP TỨC
        product.SoLuongDat++;
        product.Soluong--; 

        // cập nhật source list
        var p = Products.FirstOrDefault(x => x.Id == product.Id);
        if (p != null)
        {
            p.Soluong = product.Soluong;
        }

        StateHasChanged();
        await SaveOrdersToStorage();
    }


    private async Task DecreaseQuantity(ChiTietMonAnDTO product)
    {
        if (product.SoLuongDat <= 1) return;

        var chiTiet = await apiService.GetbyId<ChiTietMonAn, Guid>(product.Id, "ChiTietMonAn");
        if (chiTiet == null) return;

        // TRẢ KHO DB
        chiTiet.Soluong++;
        if (!await apiService.PutAsync<ChiTietMonAn>("ChiTietMonAn", chiTiet)) return;

        product.SoLuongDat--;
        product.Soluong++; 

        var p = Products.FirstOrDefault(x => x.Id == product.Id);
        if (p != null)
        {
            p.Soluong = product.Soluong;
        }

        StateHasChanged();
        await SaveOrdersToStorage();
    }


    private async Task OnQuantityChanged(ChiTietMonAnDTO product)
    {
        if (product.SoLuongDat < 1)
        {
            product.SoLuongDat = 1;
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                toast = true,
                position = "top-end",
                icon = "warning",
                title = "Số lượng tối thiểu là 1",
                showConfirmButton = false,
                timer = 2000
            });
        }
        else if (product.SoLuongDat > product.Soluong)
        {
            product.SoLuongDat = product.Soluong;
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                toast = true,
                position = "top-end",
                icon = "warning",
                title = $"Số lượng tối đa là {product.Soluong}",
                showConfirmButton = false,
                timer = 2000
            });
        }

        StateHasChanged();
        await SaveOrdersToStorage();
    }

    private async Task RemoveProduct(ChiTietMonAnDTO product)
    {
        var chiTiet = await apiService.GetbyId<ChiTietMonAn, Guid>(product.Id, "ChiTietMonAn");
        if (chiTiet != null)
        {
            chiTiet.Soluong += product.SoLuongDat;
            await apiService.PutAsync<ChiTietMonAn>("ChiTietMonAn", chiTiet);
        }
        var p = Products.FirstOrDefault(x => x.Id == product.Id);
        if (p != null)
        {
            p.Soluong = chiTiet.Soluong;
        }

        //  CẬP NHẬT SOURCE
        await RefreshProductData();
        CurrentOrder.Products.Remove(product);
        await SaveOrdersToStorage();
    }


    private System.Threading.Timer? OrderCleanupTimer;

    protected override async void OnInitialized()
    {
        Orders ??= new();
        OrderCleanupTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                var now = DateTime.Now;
                Orders.RemoveAll(o => (now - o.ThoiGianTao).TotalMinutes >= 10);
                if (CurrentOrderIndex >= Orders.Count)
                {
                    CurrentOrderIndex = Orders.Count - 1;
                }
                StateHasChanged();
                await SaveOrdersToStorage();
            });
        }, null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));

    }


    public void Dispose()
    {
        OrderCleanupTimer?.Dispose();
    }


    private void ScanQRCode()
    {
        // TODO: QR
    }

    private async void ConfirmOrder()
    {
        var nhanVienId = await JS.InvokeAsync<string>("localStorage.getItem", "currentId");
        var hoadon = new HoaDonDTO()
        {
            NhanVienId = nhanVienId,
            KhachHangId = CurrentOrder.Customer?.Id,
            LoaiHoaDon = "Tại quầy",
            GiamGiaId = CurrentOrder.ThongTinHoaDon.GiamGiaId,
            TrangThai = "hoàn thành",
            TongTien = Subtotal,
            TongTienSauKhiGiam = TotalAmount,
            GhiChu = CurrentOrder.ThongTinHoaDon.GhiChu
        };
        var result2 = await apiService.PostAsync<HoaDon, HoaDon>("HoaDon", _mapper.Map<HoaDon>(hoadon));
        if (result2 != null)
        {
            foreach (var item in CurrentOrder.Products)
            {
                // var monanchitiet = await apiService.GetbyId<ChiTietMonAn, Guid>(item.Id, "ChiTietMonAn");
                // if (monanchitiet != null)
                // {
                //     Console.WriteLine(monanchitiet.Soluong + "+" + item.SoLuongDat);
                //     monanchitiet.Soluong -= item.SoLuongDat;
                //     var result4 = await apiService.PutAsync<ChiTietMonAn>($"ChiTietMonAn", monanchitiet);
                //     if (!result4)
                //     {
                //         await JS.InvokeVoidAsync("Swal.fire", new
                //         {
                //             icon = "warning",
                //             title = $"Thất bại",
                //             text = $"Cập nhật số lượng sản phẩm thất bại."
                //         });
                //         return;
                //     }
                // }
                var hoadonchitiet = new HoaDonChiTietDTO()
                {
                    ChiTietMonAnId = item.Id,
                    HoaDonId = result2.Id,
                    Soluong = item.SoLuongDat,
                    ThanhTien = item.Gia * item.SoLuongDat,
                };
                var result3 = await apiService.PostAsync<HoaDonChiTiet, HoaDonChiTiet>("HoaDonChiTiet", _mapper.Map<HoaDonChiTiet>(hoadonchitiet));
                if (result3 != null)
                {
                    await HoaDonService.LichSuTrangThai(result3.Id, result2.TrangThai, "Hóa Đơn bán hàng tại quầy");
                }
            }

            await JS.InvokeVoidAsync("Swal.fire", new
            {
                icon = "success",
                title = "Thành công",
                text = "Đơn hàng đã được ghi nhận."
            });

            // Refresh dữ liệu sản phẩm từ server
            await RefreshProductData();

            // Cập nhật số lượng tồn kho cho các sản phẩm trong đơn hàng còn lại
            foreach (var order in Orders)
            {
                foreach (var product in order.Products)
                {
                    var updatedProduct = Products.FirstOrDefault(p => p.Id == product.Id);
                    if (updatedProduct != null)
                    {
                        product.Soluong = updatedProduct.Soluong;
                        // Nếu số lượng đặt lớn hơn tồn kho, điều chỉnh lại
                        if (product.SoLuongDat > product.Soluong)
                        {
                            product.SoLuongDat = product.Soluong;
                        }
                    }
                }
            }

            // Xóa đơn hàng đã thanh toán
            await RemoveOrder(CurrentOrderIndex);

            // Reset form thanh toán
            CustomerPay = 0;
            StateHasChanged();
        }
        else
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                icon = "warning",
                title = "Lỗi!",
                text = "Có lỗi khi lưu đơn hàng."
            });
        }
    }

    private string FormatMoney(decimal amount)
    {
        return string.Format("{0:N0} VND", amount);
    }
    private bool IsProductModalVisible = false;

    private async Task HandleAddProduct(ChiTietMonAnDTO item)
    {
        if (CurrentOrder == null || item == null) return;

        // Lấy tồn kho mới nhất từ DB
        var chiTiet = await apiService.GetbyId<ChiTietMonAn, Guid>(item.Id, "ChiTietMonAn");
        if (chiTiet == null || chiTiet.Soluong <= 0)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                icon = "warning",
                title = "Hết hàng",
                text = "Sản phẩm không còn trong kho"
            });
            return;
        }

        int soLuongThem = item.SoLuongDat > 0 ? item.SoLuongDat : 1;

        if (chiTiet.Soluong < soLuongThem)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                icon = "warning",
                title = "Không đủ hàng",
                text = $"Chỉ còn {chiTiet.Soluong} sản phẩm"
            });
            return;
        }

        //  TRỪ KHO DB
        chiTiet.Soluong -= soLuongThem;
        if (!await apiService.PutAsync<ChiTietMonAn>("ChiTietMonAn", chiTiet)) return;

        //  CẬP NHẬT LẠI DANH SÁCH SẢN PHẨM NGUỒN
        await RefreshProductData();
        //  CẬP NHẬT DANH SÁCH SẢN PHẨM (VIEW)
        var productInList = Products.FirstOrDefault(p => p.Id == item.Id);
        if (productInList != null)
        {
            productInList.Soluong = chiTiet.Soluong;
        }

        var existing = CurrentOrder.Products.FirstOrDefault(x => x.Id == item.Id);
        if (existing != null)
        {
            existing.SoLuongDat += soLuongThem;
            existing.Soluong = chiTiet.Soluong;
        }
        else
        {
            CurrentOrder.Products.Add(new ChiTietMonAnDTO
            {
                Id = item.Id,
                Ten = item.Ten,
                MonAnId = item.MonAnId,

                KichCo = item.KichCo,
                LoaiVi = item.LoaiVi,
                NguyenLieu = item.NguyenLieu,

                Gia = item.Gia,
                Soluong = chiTiet.Soluong,
                SoLuongDat = soLuongThem,
                DanhSachAnh = item.DanhSachAnh
            });

        }

        item.SoLuongDat = 1;
        StateHasChanged();
        await SaveOrdersToStorage();
    }



    private bool IsCustomerModalVisible = false;

    private async Task HandleCustomerSelected(KhachHangDTO kh)
    {
        CurrentOrder.Customer = kh;
        await SaveOrdersToStorage();
    }

    private async void Khachle()
    {
        CurrentOrder.Customer = null;
        await SaveOrdersToStorage();
    }

    protected override async Task OnInitializedAsync()
    {
        vouchers = await apiService.GetAsync<List<Voucher>>("GiamGia");
        await RefreshProductData();

        var savedOrders = await LocalStorage.GetItemAsync<List<Order>>("banhang_orders");
        var savedIndex = await LocalStorage.GetItemAsync<int>("banhang_currentIndex");
        var status = await LocalStorage.GetItemAsync<string?>("status");

        if (savedOrders != null && savedOrders.Count > 0)
        {
            Orders = savedOrders;
            CurrentOrderIndex = savedIndex;

            // Xóa các sản phẩm không còn tồn tại trong kho
            foreach (var item in Orders)
            {
                if (item?.Products != null)
                {
                    item.Products.RemoveAll(item => !Products.Any(p => p.Id == item.Id));
                }
            }

            if (status == "success")
            {
                ConfirmOrder();
                await LocalStorage.RemoveItemAsync("status");
            }

        }
        else
        {
            Orders = new();
            CurrentOrderIndex = 0;
        }

        SwitchOrder(CurrentOrderIndex);
    }

    private async Task RefreshProductData()
    {
        allProducts = await apiService.GetAsync<List<MonAnDTO>>("MonAn") ?? new();
        var allproduct = await GetChiTietMonAnService.GetAll();
        Products = allproduct
    ?.Where(p => p.TrangThai == true
        && allProducts.Any(m => m.Id == p.MonAnId && m.TrangThai))
    .ToList() ?? new();

    }

    void OnVoucherChange(ChangeEventArgs e)
    {
        string selectedVoucher = e.Value?.ToString()?.Trim();

        var voucher = vouchers.FirstOrDefault(v => v.Ten == selectedVoucher);

        if (voucher != null)
        {
            if (voucher.PhanTramKhuyenMai != null || voucher.PhanTramKhuyenMai != 0)
            {
                DiscountPercent = voucher.PhanTramKhuyenMai ?? 0 * 0.1m;
            }
            else if (voucher.SoTienKhuyenMai != null || voucher.SoTienKhuyenMai != 0)
            {
                DiscountPercent = voucher.SoTienKhuyenMai ?? 0;
            }

        }
        else
        {
            DiscountPercent = 0;
        }
    }

    private async Task SaveOrdersToStorage()
    {
        await LocalStorage.SetItemAsync("banhang_orders", Orders);
        await LocalStorage.SetItemAsync("banhang_currentIndex", CurrentOrderIndex);
    }
    // reload 
    private async Task ReloadProductStock()
    {
        await RefreshProductData();   
        StateHasChanged();
    }


    private async Task ThanhToanVnPay()
    {
        var orderId = DateTime.Now.Ticks.ToString();
        var paymentUrl = vnPayService.CreatePaymentUrl(TotalAmount, orderId, "Thanh toán hóa đơn Jolly");

        // Chuyển hướng sang VNPAY
        Nav.NavigateTo(paymentUrl, forceLoad: true);
    }

    private async void SelectPaymentMethod(string method)
    {
        PaymentMethod = method;
        CurrentOrder.ThongTinHoaDon.PhuongThucThanhToan = method == "QR" ? true : false;
        StateHasChanged();
        await SaveOrdersToStorage();
    }

    private async Task ThanhToan()
    {
        // Kiểm tra số lượng tồn kho trước khi thanh toán
        foreach (var product in CurrentOrder.Products)
        {
            var chiTiet = Products.FirstOrDefault(p => p.Id == product.Id);
            if (chiTiet == null || chiTiet.Soluong < product.SoLuongDat)
            {
                await JS.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "error",
                    title = "Không đủ số lượng",
                    text = $"Sản phẩm {product.Ten} chỉ còn {chiTiet?.Soluong ?? 0} trong kho!"
                });
                return;
            }
        }

        if (CurrentOrder.Products.Count == 0)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                icon = "warning",
                title = "Chưa thêm sản phẩm",
                text = "Đơn hàng chưa được thêm sản phẩm."
            });
            return;
        }

        if (PaymentMethod == "Cash" && CustomerPay < TotalAmount)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                icon = "warning",
                title = "Chưa đủ tiền!",
                text = $"Khách còn thiếu {FormatMoney(TotalAmount - CustomerPay)}",
                confirmButtonText = "OK"
            });
            return;
        }

        if (PaymentMethod == "Cash")
        {
            ConfirmOrder();
        }
        else if (PaymentMethod == "QR")
        {
            await ThanhToanVnPay();
        }
    }

}
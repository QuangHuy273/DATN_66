@page "/quanlykhachhang"
@layout Layout.MainLayout
@inject IHoaDonChiTietService ChiTietHoaDonService
@inject IChiTietMonAnService GetChiTietMonAnService
@inject IHoaDonService HoaDonService
@inject IApiService ApiService
@inject IJSRuntime JS
@inject IKhachHangService KhachHangService

<link href="css/HoaDon.css" rel="stylesheet" />

<h2 class="text-xl font-semibold mb-4">Quản lý khách hàng</h2>

<!-- Hàng nút -->
<div class="mb-3 d-flex justify-content-between align-items-center">
    <!-- Trái -->
    <button class="btn btn-primary" @onclick="ToggleFilter">
        🔍 Lọc
    </button>

    <!-- Phải -->
    <button class="btn-action" @onclick="() => showAdd = true">
        + Thêm khách hàng
    </button>
</div>

@if (showFilter)
{
    <div class="search-row row g-2 p-3 border rounded bg-light mb-3">
        <div class="col">
            <input class="form-control" placeholder="Tên" @bind="FilterTen" />
        </div>
        <div class="col">
            <input class="form-control" placeholder="SĐT" @bind="FilterSdt" />
        </div>
        <div class="col">
            <input class="form-control" placeholder="Email" @bind="FilterEmail" />
        </div>
        <div class="col">
            <input class="form-control" placeholder="Mã KH" @bind="FilterMa" />
        </div>
        <div class="col">
            <input type="date" class="form-control" @bind="FilterNgaySinh" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="TaiLai">Áp dụng</button>
            <button class="btn btn-warning ms-2" @onclick="ResetFilter">Reset</button>
        </div>
    </div>
}









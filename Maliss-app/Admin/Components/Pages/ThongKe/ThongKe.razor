@page "/thongke"
@layout Layout.MainLayout
@inject IApiService apiService
@inject IChiTietMonAnService ChiTietMonAnService
@inject NavigationManager manager
@inject IJSRuntime JS
@using API.Models
@using API.Models.DTO
@using API.Models.ViewModels.Thongke
@rendermode InteractiveServer

<link href="css/Thongke.css" rel="stylesheet" />

@if (isLoading)
{
    <div class="loading-overlay">
        <div class="spinner"></div>
        <p>Đang tải dữ liệu thống kê...</p>
    </div>
}
else if (hasError)
{
    <div class="error-message">
        <h3>⚠️ Có lỗi xảy ra</h3>
        <p>@errorMessage</p>
        <button class="retry-btn" @onclick="ReloadData">Thử lại</button>
    </div>
}
else
{
    <h2>Thống kê</h2>

    <!-- Summary Cards -->
    <div class="stats-cards">
        <div class="stat-card today">
            <div class="stat-title">Hôm nay</div>
            <div class="stat-value">@FormatCurrency(statsToday.TongTien)</div>
            <div class="stat-detail">
                <span>SP: @statsToday.SoLuongSP</span> |
                <span>✓ @statsToday.DonThanhCong</span> |
                <span>✗ @statsToday.DonHuy</span>
            </div>
        </div>

        <div class="stat-card week">
            <div class="stat-title">Tuần này</div>
            <div class="stat-value">@FormatCurrency(statsWeek.TongTien)</div>
            <div class="stat-detail">
                <span>SP: @statsWeek.SoLuongSP</span> |
                <span>✓ @statsWeek.DonThanhCong</span> |
                <span>✗ @statsWeek.DonHuy</span>
            </div>
        </div>

        <div class="stat-card month">
            <div class="stat-title">Tháng này</div>
            <div class="stat-value">@FormatCurrency(statsMonth.TongTien)</div>
            <div class="stat-detail">
                <span>SP: @statsMonth.SoLuongSP</span> |
                <span>✓ @statsMonth.DonThanhCong</span> |
                <span>✗ @statsMonth.DonHuy</span>
            </div>
        </div>

        <div class="stat-card year">
            <div class="stat-title">Năm nay</div>
            <div class="stat-value">@FormatCurrency(statsYear.TongTien)</div>
            <div class="stat-detail">
                <span>SP: @statsYear.SoLuongSP</span> |
                <span>✓ @statsYear.DonThanhCong</span> |
                <span>✗ @statsYear.DonHuy</span>
            </div>
        </div>
    </div>

    <!-- Filter Area -->
    <div class="filter-area">
        <span>Bộ lọc</span>
        <div class="filter-buttons">
            @foreach (var filter in filterOptions)
            {
                <button class="filter-btn @(activeFilter == filter ? "active" : "")"
                        @onclick="() => SetActiveFilter(filter)">
                    @filter
                </button>
            }
        </div>

        @if (activeFilter == "TÙY CHỈNH")
        {
            <div class="custom-date-filter">
                <label>Từ ngày:</label>
                <input type="date" @bind="customStartDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <label>Đến ngày:</label>
                <input type="date" @bind="customEndDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <button class="filter-btn" @onclick="ApplyCustomFilter">Áp dụng</button>
            </div>
        }

        <button class="export-btn" @onclick="ExportToExcel">
            📊 EXPORT TO EXCEL
        </button>
    </div>

    <!-- Main Dashboard -->
    <div class="dashboard-table-chart">
        <!-- Best Selling Products -->
        <div class="table-area">
            <div class="table-title">
                Sản phẩm bán chạy
                <small>(@bestSellingProducts.Count sản phẩm - Từ 5 đơn hoàn thành trở lên)</small>
            </div>

            @if (bestSellingProducts.Count == 0)
            {
                <div class="empty-state">
                    <p>📦 Chưa có sản phẩm nào đạt 5 đơn hoàn thành trong khoảng thời gian này</p>
                </div>
            }
            else
            {
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Số đơn</th>
                            <th>Số lượng</th>
                            <th>Doanh thu</th>
                            <th>Kích cỡ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in GetPagedProducts(bestSellingProducts, currentPage1, pageSize1))
                        {
                            <tr>
                                <td>
                                    <img src="@product.Anh"
                                         alt="@product.TenSanPham"
                                         style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;"
                                         onerror="this.src='images/placeholder.png'" />
                                </td>
                                <td>@product.TenSanPham</td>
                                <td><strong>@product.SoDonHang đơn</strong></td>
                                <td><strong>@product.SoLuong món</strong></td>
                                <td>@FormatCurrency(product.GiaTien)</td>
                                <td><span class="badge">@product.KichCo</span></td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="table-pagination">
                    <span>
                        Xem
                        <select @bind="pageSize1">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="20">20</option>
                        </select>
                        sản phẩm
                    </span>
                    <div class="pagination-btns">
                        @{
                            var totalPages1 = GetTotalPages(bestSellingProducts.Count, pageSize1);
                        }
                        <button @onclick="() => currentPage1 = Math.Max(0, currentPage1 - 1)"
                                disabled="@(currentPage1 == 0)">
                            &lt;
                        </button>
                        @for (int i = 0; i < totalPages1; i++)
                        {
                            var page = i;
                            <button @onclick="() => currentPage1 = page"
                                    class="@(i == currentPage1 ? "active" : "")">
                                @(i + 1)
                            </button>
                        }
                        <button @onclick="() => currentPage1 = Math.Min(totalPages1 - 1, currentPage1 + 1)"
                                disabled="@(currentPage1 == totalPages1 - 1)">
                            &gt;
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Order Status Chart -->
        <div class="stats-right">
            <div class="chart-area">
                <div class="chart-title">Trạng thái đơn hàng</div>
                @if (orderStatusData.Sum(x => x.Value) > 0)
                {
                    <div class="fake-pie" style="background: @BuildPieGradient()"></div>
                    <div class="chart-legend">
                        @foreach (var item in orderStatusData.Where(x => x.Value > 0))
                        {
                            <div>
                                <div class="legend-color" style="background:@item.Color"></div>
                                <span>@item.Label (@item.Value - @item.Percentage%)</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-chart">
                        <p>📊 Chưa có đơn hàng</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Low Stock Products & Performance Stats -->
    <div class="dashboard-table-chart">
        <!-- Low Stock Products -->
        <div class="table-area">
            <div class="table-title">
                Sản phẩm sắp hết hàng
                <small>(@lowStockProducts.Count sản phẩm)</small>
            </div>

            @if (lowStockProducts.Count == 0)
            {
                <div class="empty-state">
                    <p>✅ Tất cả sản phẩm đều còn hàng đầy đủ</p>
                </div>
            }
            else
            {
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Tồn kho</th>
                            <th>Giá</th>
                            <th>Kích cỡ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in GetPagedProducts(lowStockProducts, currentPage2, pageSize2))
                        {
                            <tr class="@(product.SoLuong < 5 ? "low-stock-critical" : "")">
                                <td>
                                    <img src="@product.Anh"
                                         alt="@product.TenSanPham"
                                         style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;"
                                         onerror="this.src='images/placeholder.png'" />
                                </td>
                                <td>@product.TenSanPham</td>
                                <td>
                                    <strong class="@(product.SoLuong < 5 ? "text-danger" : "text-warning")">
                                        @product.SoLuong
                                    </strong>
                                </td>
                                <td>@FormatCurrency(product.GiaTien)</td>
                                <td><span class="badge">@product.KichCo</span></td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="table-pagination">
                    <span>
                        Xem
                        <select @bind="pageSize2">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="20">20</option>
                        </select>
                        sản phẩm
                    </span>
                    <div class="pagination-btns">
                        @{
                            var totalPages2 = GetTotalPages(lowStockProducts.Count, pageSize2);
                        }
                        <button @onclick="() => currentPage2 = Math.Max(0, currentPage2 - 1)"
                                disabled="@(currentPage2 == 0)">
                            &lt;
                        </button>
                        @for (int i = 0; i < totalPages2; i++)
                        {
                            var page = i;
                            <button @onclick="() => currentPage2 = page"
                                    class="@(i == currentPage2 ? "active" : "")">
                                @(i + 1)
                            </button>
                        }
                        <button @onclick="() => currentPage2 = Math.Min(totalPages2 - 1, currentPage2 + 1)"
                                disabled="@(currentPage2 == 0)">
                            &gt;
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Performance Stats Cards -->
        <div class="stats-right">
            <div class="stats-card">
                <span class="stats-icon">📊</span> Doanh thu ngày
                <span class="stats-value">@FormatCurrency(statsToday.TongTien)</span>
                <span class="stats-percent @GetPercentClass(compareToday.DoanhThu)">
                    @FormatPercent(compareToday.DoanhThu)
                </span>
            </div>

            <div class="stats-card">
                <span class="stats-icon">📊</span> Doanh thu tuần
                <span class="stats-value">@FormatCurrency(statsWeek.TongTien)</span>
                <span class="stats-percent @GetPercentClass(compareWeek.DoanhThu)">
                    @FormatPercent(compareWeek.DoanhThu)
                </span>
            </div>

            <div class="stats-card">
                <span class="stats-icon">📊</span> Doanh thu tháng
                <span class="stats-value">@FormatCurrency(statsMonth.TongTien)</span>
                <span class="stats-percent @GetPercentClass(compareMonth.DoanhThu)">
                    @FormatPercent(compareMonth.DoanhThu)
                </span>
            </div>

            <div class="stats-card">
                <span class="stats-icon">📊</span> Doanh thu năm
                <span class="stats-value">@FormatCurrency(statsYear.TongTien)</span>
                <span class="stats-percent @GetPercentClass(compareYear.DoanhThu)">
                    @FormatPercent(compareYear.DoanhThu)
                </span>
            </div>

            <div class="stats-card">
                <span class="stats-icon">📦</span> Đơn hàng ngày
                <span class="stats-value">@statsToday.DonThanhCong</span>
                <span class="stats-percent @GetPercentClass(compareToday.DonHang)">
                    @FormatPercent(compareToday.DonHang)
                </span>
            </div>

            <div class="stats-card">
                <span class="stats-icon">📦</span> Đơn hàng tuần
                <span class="stats-value">@statsWeek.DonThanhCong</span>
                <span class="stats-percent @GetPercentClass(compareWeek.DonHang)">
                    @FormatPercent(compareWeek.DonHang)
                </span>
            </div>

            <div class="stats-card">
                <span class="stats-icon">📦</span> Đơn hàng tháng
                <span class="stats-value">@statsMonth.DonThanhCong</span>
                <span class="stats-percent @GetPercentClass(compareMonth.DonHang)">
                    @FormatPercent(compareMonth.DonHang)
                </span>
            </div>

            <div class="stats-card">
                <span class="stats-icon">📦</span> Đơn hàng năm
                <span class="stats-value">@statsYear.DonThanhCong</span>
                <span class="stats-percent @GetPercentClass(compareYear.DonHang)">
                    @FormatPercent(compareYear.DonHang)
                </span>
            </div>

            <div class="stats-card">
                <span class="stats-icon">👟</span> Sản phẩm ngày
                <span class="stats-value">@statsToday.SoLuongSP</span>
                <span class="stats-percent @GetPercentClass(compareToday.SanPham)">
                    @FormatPercent(compareToday.SanPham)
                </span>
            </div>

            <div class="stats-card">
                <span class="stats-icon">👟</span> Sản phẩm tuần
                <span class="stats-value">@statsWeek.SoLuongSP</span>
                <span class="stats-percent @GetPercentClass(compareWeek.SanPham)">
                    @FormatPercent(compareWeek.SanPham)
                </span>
            </div>

            <div class="stats-card">
                <span class="stats-icon">👟</span> Sản phẩm tháng
                <span class="stats-value">@statsMonth.SoLuongSP</span>
                <span class="stats-percent @GetPercentClass(compareMonth.SanPham)">
                    @FormatPercent(compareMonth.SanPham)
                </span>
            </div>

            <div class="stats-card">
                <span class="stats-icon">👟</span> Sản phẩm năm
                <span class="stats-value">@statsYear.SoLuongSP</span>
                <span class="stats-percent @GetPercentClass(compareYear.SanPham)">
                    @FormatPercent(compareYear.SanPham)
                </span>
            </div>
        </div>
    </div>
}

@code {
    // Models
    private class PeriodStats
    {
        public decimal TongTien { get; set; }
        public int SoLuongSP { get; set; }
        public int DonThanhCong { get; set; }
        public int DonHuy { get; set; }
    }

    private class ComparisonStats
    {
        public decimal DoanhThu { get; set; }
        public decimal DonHang { get; set; }
        public decimal SanPham { get; set; }
    }

    private class ChartData
    {
        public string Label { get; set; } = "";
        public string Color { get; set; } = "";
        public int Value { get; set; }
        public string Percentage { get; set; } = "0";
    }

    // Data
    private List<HoaDon> hoaDons = new();
    private List<HoaDonChiTiet> hoaDonChiTiets = new();
    private List<ChiTietMonAnDTO> chitietmonAns = new();

    // Stats
    private PeriodStats statsToday = new();
    private PeriodStats statsWeek = new();
    private PeriodStats statsMonth = new();
    private PeriodStats statsYear = new();

    // Comparisons
    private ComparisonStats compareToday = new();
    private ComparisonStats compareWeek = new();
    private ComparisonStats compareMonth = new();
    private ComparisonStats compareYear = new();

    // Products
    private List<DanhSachSanPhamBanChay> bestSellingProducts = new();
    private List<DanhSachSanPhamBanChay> lowStockProducts = new();

    // Chart
    private List<ChartData> orderStatusData = new();

    // UI State
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = "";
    private string activeFilter = "NGÀY";
    private List<string> filterOptions = new() { "NGÀY", "TUẦN", "THÁNG", "NĂM", "TÙY CHỈNH" };
    private DateTime customStartDate = DateTime.Now.AddDays(-7);
    private DateTime customEndDate = DateTime.Now;

    // Pagination
    private int currentPage1 = 0;
    private int pageSize1 = 5;
    private int currentPage2 = 0;
    private int pageSize2 = 5;

    // Constants
    private const int LOW_STOCK_THRESHOLD = 20;
    private const int MIN_ORDERS_FOR_BEST_SELLING = 5; // Ngưỡng đơn hàng tối thiểu

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            hasError = false;
            StateHasChanged();

            // Load data
            hoaDons = await apiService.GetAsync<List<HoaDon>>("HoaDon") ?? new();
            hoaDonChiTiets = await apiService.GetAsync<List<HoaDonChiTiet>>("HoaDonChiTiet") ?? new();
            chitietmonAns = await ChiTietMonAnService.GetAll();

            // Calculate all stats
            CalculateAllStats();
            LoadLowStockProducts();
            await ApplyFilter();

            isLoading = false;
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = $"Lỗi tải dữ liệu: {ex.Message}";
            isLoading = false;
        }

        StateHasChanged();
    }

    private async Task ReloadData()
    {
        await LoadData();
    }

    private void CalculateAllStats()
    {
        var now = DateTime.Now;

        // Today
        statsToday = CalculateStats(now.Date, now.Date);
        var prevDay = CalculateStats(now.Date.AddDays(-1), now.Date.AddDays(-1));
        compareToday = CompareStats(statsToday, prevDay);

        // Week
        var (weekStart, weekEnd) = GetWeekRange(now);
        statsWeek = CalculateStats(weekStart, weekEnd);
        var (prevWeekStart, prevWeekEnd) = GetWeekRange(now.AddDays(-7));
        var prevWeek = CalculateStats(prevWeekStart, prevWeekEnd);
        compareWeek = CompareStats(statsWeek, prevWeek);

        // Month
        var monthStart = new DateTime(now.Year, now.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);
        statsMonth = CalculateStats(monthStart, monthEnd);
        var prevMonthStart = monthStart.AddMonths(-1);
        var prevMonthEnd = prevMonthStart.AddMonths(1).AddDays(-1);
        var prevMonth = CalculateStats(prevMonthStart, prevMonthEnd);
        compareMonth = CompareStats(statsMonth, prevMonth);

        // Year
        var yearStart = new DateTime(now.Year, 1, 1);
        var yearEnd = new DateTime(now.Year, 12, 31);
        statsYear = CalculateStats(yearStart, yearEnd);
        var prevYear = CalculateStats(yearStart.AddYears(-1), yearEnd.AddYears(-1));
        compareYear = CompareStats(statsYear, prevYear);
    }

    private PeriodStats CalculateStats(DateTime start, DateTime end)
    {
        var filteredOrders = hoaDons.Where(h =>
            h.NgayTao.Date >= start && h.NgayTao.Date <= end).ToList();

        // Chỉ tính đơn hoàn thành
        var completedOrders = filteredOrders.Where(h =>
            h.TrangThai?.Equals("hoàn thành", StringComparison.OrdinalIgnoreCase) == true).ToList();

        var stats = new PeriodStats
        {
            TongTien = completedOrders.Sum(h => h.TongTien),
            DonThanhCong = completedOrders.Count,
            DonHuy = filteredOrders.Count(h =>
                h.TrangThai?.Equals("Đã huỷ", StringComparison.OrdinalIgnoreCase) == true)
        };

        // Calculate products sold from completed orders only
        var completedOrderIds = completedOrders.Select(h => h.Id).ToHashSet();
        stats.SoLuongSP = hoaDonChiTiets
            .Where(hc => completedOrderIds.Contains(hc.HoaDonId) && hc.TrangThai == true)
            .Sum(hc => hc.Soluong);

        return stats;
    }

    private ComparisonStats CompareStats(PeriodStats current, PeriodStats previous)
    {
        return new ComparisonStats
        {
            DoanhThu = CalculateChangePercent(current.TongTien, previous.TongTien),
            DonHang = CalculateChangePercent(current.DonThanhCong, previous.DonThanhCong),
            SanPham = CalculateChangePercent(current.SoLuongSP, previous.SoLuongSP)
        };
    }

    private decimal CalculateChangePercent(decimal current, decimal previous)
    {
        if (previous == 0) return current > 0 ? 100m : 0m;
        return Math.Round((current - previous) / previous * 100m, 1);
    }

    private (DateTime start, DateTime end) GetWeekRange(DateTime date)
    {
        int diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        var start = date.AddDays(-diff).Date;
        return (start, start.AddDays(6));
    }

    private void LoadLowStockProducts()
    {
        lowStockProducts = chitietmonAns
            .Where(c => c.Soluong <= LOW_STOCK_THRESHOLD)
            .GroupBy(c => c.MonAnId)
            .Select(g =>
            {
                var first = g.First();
                return new DanhSachSanPhamBanChay
                {
                    Anh = first.DanhSachAnh?.FirstOrDefault()?.DuongDan ?? "",
                    TenSanPham = first.Ten ?? "Không rõ",
                    SoLuong = g.Sum(x => x.Soluong),
                    GiaTien = g.Min(x => x.Gia),
                    KichCo = string.Join(", ", g.Select(x => x.KichCo).Distinct())
                };
            })
            .OrderBy(p => p.SoLuong)
            .ToList();
    }

    private async Task SetActiveFilter(string filter)
    {
        activeFilter = filter;
        await ApplyFilter();
    }

    private async Task ApplyCustomFilter()
    {
        if (customEndDate < customStartDate)
        {
            await JS.InvokeVoidAsync("alert", "Ngày kết thúc phải sau ngày bắt đầu");
            return;
        }
        await ApplyFilter();
    }

    private async Task ApplyFilter()
    {
        var (start, end) = GetFilterDateRange();

        // Chỉ lấy đơn hoàn thành
        var completedOrders = hoaDons
            .Where(h => h.NgayTao.Date >= start && h.NgayTao.Date <= end &&
                       h.TrangThai?.Equals("hoàn thành", StringComparison.OrdinalIgnoreCase) == true)
            .Select(h => h.Id)
            .ToList();

        // Nhóm sản phẩm theo tên và đếm số đơn hàng
        var productOrderCounts = (from hdct in hoaDonChiTiets
                                  where completedOrders.Contains(hdct.HoaDonId) && hdct.TrangThai == true
                                  join ma in chitietmonAns on hdct.ChiTietMonAnId equals ma.Id
                                  group new { hdct, ma } by ma.Ten into g
                                  select new
                                  {
                                      TenSanPham = g.Key,
                                      SoDonHang = g.Select(x => x.hdct.HoaDonId).Distinct().Count(),
                                      SoLuong = g.Sum(x => x.hdct.Soluong),
                                      DoanhThu = g.Sum(x => x.hdct.ThanhTien),
                                      Anh = g.First().ma.DanhSachAnh?.FirstOrDefault()?.DuongDan ?? "",
                                      KichCo = string.Join(", ", g.Select(x => x.ma.KichCo).Distinct())
                                  }).ToList();

        // Chỉ lấy sản phẩm có từ 5 đơn hàng trở lên
        bestSellingProducts = productOrderCounts
            .Where(p => p.SoDonHang >= MIN_ORDERS_FOR_BEST_SELLING)
            .Select(p => new DanhSachSanPhamBanChay
            {
                TenSanPham = p.TenSanPham,
                Anh = p.Anh,
                SoDonHang = p.SoDonHang,
                SoLuong = p.SoLuong,
                GiaTien = p.DoanhThu,
                KichCo = p.KichCo
            })
            .OrderByDescending(p => p.SoDonHang)
            .ThenByDescending(p => p.SoLuong)
            .ToList();

        // Calculate order status percentages
        CalculateOrderStatusPercentages(start, end);

        currentPage1 = 0;
        currentPage2 = 0;
    }

    private (DateTime start, DateTime end) GetFilterDateRange()
    {
        return activeFilter switch
        {
            "NGÀY" => (DateTime.Now.Date, DateTime.Now.Date),
            "TUẦN" => GetWeekRange(DateTime.Now),
            "THÁNG" => (new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1),
                       new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1)),
            "NĂM" => (new DateTime(DateTime.Now.Year, 1, 1),
                     new DateTime(DateTime.Now.Year, 12, 31)),
            "TÙY CHỈNH" => (customStartDate.Date, customEndDate.Date),
            _ => (DateTime.Now.Date, DateTime.Now.Date)
        };
    }

    private void CalculateOrderStatusPercentages(DateTime start, DateTime end)
    {
        var filteredOrders = hoaDons
            .Where(h => h.NgayTao.Date >= start && h.NgayTao.Date <= end)
            .ToList();

        int total = filteredOrders.Count;

        if (total == 0)
        {
            orderStatusData = new List<ChartData>();
            return;
        }

        // Sử dụng trạng thái giống trang hóa đơn
        var statusCounts = new Dictionary<string, (int count, string color)>
        {
            ["Đã huỷ"] = (0, "#e74c3c"),
            ["Chờ xác nhận"] = (0, "#3498db"),
            ["Xác nhận"] = (0, "#3498db"),
            ["Chờ giao"] = (0, "#f39c12"),
            ["Vận chuyển"] = (0, "#3498db"),
            ["Đã giao"] = (0, "#2ecc71"),
            ["Đã thanh toán"] = (0, "#2ecc71"),
            ["hoàn thành"] = (0, "#8e44ad")
        };

        // Count orders by status
        foreach (var order in filteredOrders)
        {
            var status = order.TrangThai ?? "";
            if (statusCounts.ContainsKey(status))
            {
                statusCounts[status] = (statusCounts[status].count + 1, statusCounts[status].color);
            }
        }

        orderStatusData = new List<ChartData>
        {
            new ChartData { Label = "Đã huỷ", Color = "#e74c3c", Value = statusCounts["Đã huỷ"].count,
                           Percentage = Math.Round((double)statusCounts["Đã huỷ"].count / total * 100, 1).ToString("0.#") },
            new ChartData { Label = "Chờ xác nhận", Color = "#3498db", Value = statusCounts["Chờ xác nhận"].count,
                           Percentage = Math.Round((double)statusCounts["Chờ xác nhận"].count / total * 100, 1).ToString("0.#") },
            new ChartData { Label = "Xác nhận", Color = "#3498db", Value = statusCounts["Xác nhận"].count,
                           Percentage = Math.Round((double)statusCounts["Xác nhận"].count / total * 100, 1).ToString("0.#") },
            new ChartData { Label = "Chờ giao", Color = "#f39c12", Value = statusCounts["Chờ giao"].count,
                           Percentage = Math.Round((double)statusCounts["Chờ giao"].count / total * 100, 1).ToString("0.#") },
            new ChartData { Label = "Vận chuyển", Color = "#3498db", Value = statusCounts["Vận chuyển"].count,
                           Percentage = Math.Round((double)statusCounts["Vận chuyển"].count / total * 100, 1).ToString("0.#") },
            new ChartData { Label = "Đã giao", Color = "#2ecc71", Value = statusCounts["Đã giao"].count,
                           Percentage = Math.Round((double)statusCounts["Đã giao"].count / total * 100, 1).ToString("0.#") },
            new ChartData { Label = "Đã thanh toán", Color = "#2ecc71", Value = statusCounts["Đã thanh toán"].count,
                           Percentage = Math.Round((double)statusCounts["Đã thanh toán"].count / total * 100, 1).ToString("0.#") },
            new ChartData { Label = "Hoàn thành", Color = "#8e44ad", Value = statusCounts["hoàn thành"].count,
                           Percentage = Math.Round((double)statusCounts["hoàn thành"].count / total * 100, 1).ToString("0.#") }
        };
    }

    private string BuildPieGradient()
    {
        var dataWithValues = orderStatusData.Where(x => x.Value > 0).ToList();
        if (!dataWithValues.Any()) return "conic-gradient(#ddd 0deg 360deg)";

        var total = dataWithValues.Sum(x => x.Value);
        var parts = new List<string>();
        double startAngle = 0;

        foreach (var item in dataWithValues)
        {
            double percentage = (double)item.Value / total;
            double endAngle = startAngle + (percentage * 360);
            parts.Add($"{item.Color} {startAngle:F1}deg {endAngle:F1}deg");
            startAngle = endAngle;
        }

        return $"conic-gradient({string.Join(", ", parts)})";
    }

    // Helper Methods
    private string FormatCurrency(decimal amount)
    {
        return amount.ToString("N0") + " ₫";
    }

    private string FormatPercent(decimal percent)
    {
        if (percent == 0) return "0%";
        return (percent > 0 ? "+" : "") + percent.ToString("0.#") + "%";
    }

    private string GetPercentClass(decimal percent)
    {
        if (percent > 0) return "up";
        if (percent < 0) return "down";
        return "";
    }

    private List<DanhSachSanPhamBanChay> GetPagedProducts(List<DanhSachSanPhamBanChay> products, int page, int size)
    {
        return products.Skip(page * size).Take(size).ToList();
    }

    private int GetTotalPages(int totalItems, int pageSize)
    {
        return (int)Math.Ceiling((double)totalItems / pageSize);
    }

